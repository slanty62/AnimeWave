@model AnimeWave.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход";

    string? returnUrl = ViewBag.ReturnUrl as string;
}

<section class="aw-auth-page">

    <!-- ДЕКОРАТИВНЫЙ ФОН -->

    <div class="aw-auth-glow aw-auth-glow-one"></div>
    <div class="aw-auth-glow aw-auth-glow-two"></div>

    <div class="aw-auth-grid"></div>


    <!-- ОСНОВНАЯ КАРТОЧКА -->

    <div class="aw-auth-container">

        <!-- ЛЕВАЯ ЧАСТЬ -->

        <div class="aw-auth-promo">

            <div class="aw-auth-promo-content">

                <div class="aw-auth-big-logo">
                    A
                </div>

                <span class="aw-auth-eyebrow">
                    WELCOME TO ANIMEWAVE
                </span>

                <h1>
                    С возвращением
                    <span>в мир аниме.</span>
                </h1>

                <p>
                    Войди в аккаунт, чтобы сохранять
                    любимые аниме, продолжать просмотр
                    и управлять своей коллекцией.
                </p>


                <div class="aw-auth-features">

                    <div class="aw-auth-feature">

                        <div class="aw-auth-feature-icon">
                            ✓
                        </div>

                        <span>
                            Добавляй аниме в избранное
                        </span>

                    </div>


                    <div class="aw-auth-feature">

                        <div class="aw-auth-feature-icon">
                            ✓
                        </div>

                        <span>
                            Получай доступ к своей коллекции
                        </span>

                    </div>


                    <div class="aw-auth-feature">

                        <div class="aw-auth-feature-icon">
                            ✓
                        </div>

                        <span>
                            Используй AnimeWave на разных устройствах
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ПРАВАЯ ЧАСТЬ / ФОРМА -->

        <div class="aw-auth-form-side">

            <div class="aw-auth-form-header">

                <span class="aw-auth-mobile-logo">
                    A
                </span>

                <span class="aw-auth-small-label">
                    ANIMEWAVE ACCOUNT
                </span>

                <h2>
                    Войти
                </h2>

                <p>
                    Введи данные своего аккаунта.
                </p>

            </div>


            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="aw-auth-form">

                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden"
                           name="returnUrl"
                           value="@returnUrl" />
                }


                <!-- ОБЩИЕ ОШИБКИ -->

                <div asp-validation-summary="ModelOnly"
                     class="aw-validation-summary">
                </div>


                <!-- EMAIL -->

                <div class="aw-auth-field">

                    <label asp-for="Email">
                        Email
                    </label>

                    <div class="aw-auth-input-wrap">

                        <span class="aw-auth-input-icon">

                            <svg viewBox="0 0 24 24">
                                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 3.4V18h16V7.4l-8 5-8-5Zm1.2-1.4L12 10.25 18.8 6H5.2Z" />
                            </svg>

                        </span>

                        <input asp-for="Email"
                               autocomplete="email"
                               placeholder="name@example.com" />

                    </div>

                    <span asp-validation-for="Email"
                          class="aw-field-error">
                    </span>

                </div>


                <!-- ПАРОЛЬ -->

                <div class="aw-auth-field">

                    <div class="aw-auth-label-row">

                        <label asp-for="Password">
                            Пароль
                        </label>

                    </div>

                    <div class="aw-auth-input-wrap">

                        <span class="aw-auth-input-icon">

                            <svg viewBox="0 0 24 24">
                                <path d="M17 8h-1V6a4 4 0 1 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V6Zm7 13H7v-9h10v9Z" />
                            </svg>

                        </span>

                        <input asp-for="Password"
                               autocomplete="current-password"
                               placeholder="Введите пароль" />

                    </div>

                    <span asp-validation-for="Password"
                          class="aw-field-error">
                    </span>

                </div>


                <!-- ЗАПОМНИТЬ -->

                <div class="aw-auth-options">

                    <label class="aw-custom-checkbox">

                        <input asp-for="RememberMe" />

                        <span class="aw-checkbox-ui">
                            ✓
                        </span>

                        <span>
                            Запомнить меня
                        </span>

                    </label>

                </div>


                <!-- КНОПКА -->

                <button type="submit"
                        class="aw-auth-submit">

                    <span>
                        Войти в AnimeWave
                    </span>

                    <svg viewBox="0 0 24 24">
                        <path d="m13 5-1.4 1.4 4.6 4.6H4v2h12.2l-4.6 4.6L13 19l7-7-7-7Z" />
                    </svg>

                </button>


                <!-- РАЗДЕЛИТЕЛЬ -->

                <div class="aw-auth-divider">

                    <span></span>

                    <p>
                        или
                    </p>

                    <span></span>

                </div>


                <!-- РЕГИСТРАЦИЯ -->

                <a asp-controller="Account"
                   asp-action="Register"
                   class="aw-auth-secondary">

                    Создать новый аккаунт

                </a>

            </form>


            <div class="aw-auth-bottom-text">

                <span>
                    Нет аккаунта?
                </span>

                <a asp-controller="Account"
                   asp-action="Register">

                    Зарегистрироваться

                </a>

            </div>

        </div>

    </div>

</section>