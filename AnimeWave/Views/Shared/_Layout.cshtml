@using AnimeWave.Models
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager

@{
    // =========================================================
    // CURRENT USER
    // =========================================================

    ApplicationUser? layoutUser = null;


    if (User.Identity?.IsAuthenticated == true)
    {
        layoutUser =
            await UserManager
                .GetUserAsync(User);
    }



    // =========================================================
    // GLOBAL THEME
    // =========================================================

    string animeWaveTheme =
        layoutUser?.ThemeStyle switch
        {
            "sakura" => "sakura",

            "cyber" => "cyber",

            "ocean" => "ocean",

            "crimson" => "crimson",

            _ => "violet"
        };



    // =========================================================
    // NAVBAR AVATAR
    // =========================================================

    string navbarAvatarStyle =
        layoutUser?.AvatarStyle switch
        {
            "sakura" => "sakura",

            "kitsune" => "kitsune",

            "blade" => "blade",

            "neko" => "neko",

            "star" => "star",

            "cyber" => "cyber",

            "wave" => "wave",

            _ => "violet"
        };


    string navbarAvatarSymbol =
        navbarAvatarStyle switch
        {
            "sakura" => "桜",

            "kitsune" => "狐",

            "blade" => "刀",

            "neko" => "猫",

            "star" => "星",

            "cyber" => "夢",

            "wave" => "波",

            _ => "月"
        };


    string navbarDisplayName =
        !string.IsNullOrWhiteSpace(
            layoutUser?.DisplayName
        )
            ? layoutUser!.DisplayName!
            : (
                layoutUser?.UserName
                ??
                User.Identity?.Name
                ??
                "Профиль"
            );
}

<!DOCTYPE html>

<html lang="ru">

<head>

    <meta charset="utf-8" />


    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <meta name="theme-color"
          content="#080a0f" />


    <title>
        @ViewData["Title"] - AnimeWave
    </title>



    <!-- =========================================================
         BOOTSTRAP
         ========================================================= -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />



    <!-- =========================================================
         ANIMEWAVE
         ========================================================= -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>



<body class="aw-site-body aw-theme-@animeWaveTheme">


    <!-- =========================================================
         NAVBAR
         ========================================================= -->

    <header class="aw-navbar">

        <div class="aw-navbar-inner">


            <!-- =================================================
                 LOGO
                 ================================================= -->

            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="aw-navbar-logo">

                <span class="aw-navbar-logo-mark">

                    <i></i>
                    <i></i>
                    <i></i>

                </span>


                <span class="aw-navbar-logo-text">

                    Anime<strong>Wave</strong>

                </span>

            </a>



            <!-- =================================================
                 DESKTOP NAVIGATION
                 ================================================= -->

            <nav class="aw-navbar-links"
                 aria-label="Основная навигация">


                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    Главная

                </a>


                <a asp-area=""
                   asp-controller="Anime"
                   asp-action="Index">

                    Каталог

                </a>



                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area=""
                       asp-controller="Favorites"
                       asp-action="Index">

                        Избранное

                    </a>
                }



                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin"
                       asp-controller="Home"
                       asp-action="Index"
                       class="aw-navbar-admin">

                        Админка

                    </a>
                }

            </nav>



            <!-- =================================================
                 RIGHT
                 ================================================= -->

            <div class="aw-navbar-actions">


                <!-- =============================================
                     SMART SEARCH
                     ============================================= -->

                <button type="button"
                        class="aw-navbar-search"
                        id="awSmartSearchButton"
                        title="Поиск аниме"
                        aria-label="Открыть поиск">

                    <svg width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">

                        <circle cx="11"
                                cy="11"
                                r="6.5"
                                stroke="currentColor"
                                stroke-width="1.7" />

                        <path d="M16 16L20 20"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round" />

                    </svg>

                </button>



                <!-- =============================================
                     AUTHENTICATED
                     ============================================= -->
                @if (User.Identity?.IsAuthenticated == true)
                {

                    <!-- PROFILE -->

                    <a asp-area=""
                       asp-controller="Profile"
                       asp-action="Index"
                       class="aw-navbar-profile"
                       title="@navbarDisplayName">


                        <span class="aw-navbar-user aw-avatar-@navbarAvatarStyle">

                            @navbarAvatarSymbol

                        </span>


                        <span class="aw-navbar-profile-name">

                            @navbarDisplayName

                        </span>

                    </a>



                    <!-- LOGOUT -->

                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="aw-navbar-logout-form"
                          data-no-loading>

                        @Html.AntiForgeryToken()


                        <button type="submit"
                                class="aw-navbar-logout"
                                title="Выйти">

                            <svg width="17"
                                 height="17"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">

                                <path d="M10 6H6.5C5.67157 6 5 6.67157 5 7.5V16.5C5 17.3284 5.67157 18 6.5 18H10"
                                      stroke="currentColor"
                                      stroke-width="1.7"
                                      stroke-linecap="round" />


                                <path d="M14 8L18 12L14 16"
                                      stroke="currentColor"
                                      stroke-width="1.7"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />


                                <path d="M18 12H9"
                                      stroke="currentColor"
                                      stroke-width="1.7"
                                      stroke-linecap="round" />

                            </svg>

                        </button>

                    </form>
                }

                else
                {

                    <!-- LOGIN -->

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Login"
                       class="aw-navbar-login">

                        Войти

                    </a>



                    <!-- REGISTER -->

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Register"
                       class="aw-navbar-register">

                        Регистрация

                    </a>
                }

            </div>

        </div>

    </header>



    <!-- =========================================================
         TOAST CONTAINER
         ========================================================= -->

    <div class="aw-toast-container"
         id="awToastContainer">


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="aw-toast aw-toast-success"
                 data-aw-toast>

                <div class="aw-toast-icon">

                    ✓

                </div>


                <div class="aw-toast-content">

                    <span>
                        SUCCESS
                    </span>


                    <p>
                        @TempData["SuccessMessage"]
                    </p>

                </div>


                <button type="button"
                        class="aw-toast-close"
                        aria-label="Закрыть уведомление">

                    ×

                </button>

            </div>
        }



        @if (TempData["ErrorMessage"] != null)
        {
            <div class="aw-toast aw-toast-error"
                 data-aw-toast>

                <div class="aw-toast-icon">

                    !

                </div>


                <div class="aw-toast-content">

                    <span>
                        ERROR
                    </span>


                    <p>
                        @TempData["ErrorMessage"]
                    </p>

                </div>


                <button type="button"
                        class="aw-toast-close"
                        aria-label="Закрыть уведомление">

                    ×

                </button>

            </div>
        }



        @if (TempData["InfoMessage"] != null)
        {
            <div class="aw-toast aw-toast-info"
                 data-aw-toast>

                <div class="aw-toast-icon">

                    i

                </div>


                <div class="aw-toast-content">

                    <span>
                        INFO
                    </span>


                    <p>
                        @TempData["InfoMessage"]
                    </p>

                </div>


                <button type="button"
                        class="aw-toast-close"
                        aria-label="Закрыть уведомление">

                    ×

                </button>

            </div>
        }

    </div>



    <!-- =========================================================
         PAGE
         ========================================================= -->

    <main class="aw-page-enter"
          role="main">

        @RenderBody()

    </main>



    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="aw-footer">

        <div class="aw-footer-inner">


            <div class="aw-footer-brand">

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="aw-footer-logo">

                    Anime<strong>Wave</strong>

                </a>


                <p>
                    Современный каталог аниме.
                    Находи, сохраняй и открывай новые истории.
                </p>

            </div>



            <div class="aw-footer-links">

                <div>

                    <span>
                        NAVIGATION
                    </span>


                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        Главная

                    </a>


                    <a asp-area=""
                       asp-controller="Anime"
                       asp-action="Index">

                        Каталог

                    </a>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area=""
                           asp-controller="Favorites"
                           asp-action="Index">

                            Избранное

                        </a>
                    }

                </div>



                <div>

                    <span>
                        ACCOUNT
                    </span>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-area=""
                           asp-controller="Profile"
                           asp-action="Index">

                            Профиль

                        </a>


                        <a asp-area=""
                           asp-controller="Profile"
                           asp-action="Edit">

                            Настройки

                        </a>
                    }
                    else
                    {
                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Login">

                            Войти

                        </a>


                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Register">

                            Регистрация

                        </a>
                    }

                </div>

            </div>



            <div class="aw-footer-bottom">

                <span>

                    © @DateTime.Now.Year AnimeWave

                </span>


                <span>

                    ASP.NET Core MVC · PostgreSQL

                </span>

            </div>

        </div>

    </footer>



    <!-- =========================================================
         SMART SEARCH
         ========================================================= -->
    @await Html.PartialAsync("_SmartSearch")



    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>



    <!-- =========================================================
         GLOBAL ANIMEWAVE UI
         ========================================================= -->

    <script>

            document.addEventListener(
                "DOMContentLoaded",
                function() {

                    // =================================================
                    // TOASTS
                    // =================================================

                    const toasts =
                        document.querySelectorAll(
                            "[data-aw-toast]"
                        );


                    toasts.forEach(
                        function(toast, index) {

                            setTimeout(
                                function() {

                                    toast.classList.add(
                                        "is-visible"
                                    );

                                },
                                120 * index
                            );


                            const closeButton =
                                toast.querySelector(
                                    ".aw-toast-close"
                                );


                            function closeToast() {

                                toast.classList.remove(
                                    "is-visible"
                                );


                                toast.classList.add(
                                    "is-hiding"
                                );


                                setTimeout(
                                    function() {

                                        toast.remove();

                                    },
                                    350
                                );

                            }


                            if (closeButton) {

                                closeButton.addEventListener(
                                    "click",
                                    closeToast
                                );

                            }


                            setTimeout(
                                closeToast,
                                4500 + (index * 250)
                            );

                        }
                    );



                    // =================================================
                    // CARD REVEAL
                    // =================================================

                    const revealItems =
                        document.querySelectorAll(
                            ".aw-card-reveal"
                        );


                    if (
                        "IntersectionObserver"
                        in window
                    ) {
                        const revealObserver =
                            new IntersectionObserver(
                                function(entries) {

                                    entries.forEach(
                                        function(entry) {

                                            if (
                                                entry.isIntersecting
                                            ) {
                                                entry.target
                                                    .classList
                                                    .add(
                                                        "is-visible"
                                                    );


                                                revealObserver
                                                    .unobserve(
                                                        entry.target
                                                    );
                                            }

                                        }
                                    );

                                },
                                {
                                    threshold: 0.08
                                }
                            );


                        revealItems.forEach(
                            function(item) {

                                revealObserver.observe(
                                    item
                                );

                            }
                        );
                    }
                    else {
                        revealItems.forEach(
                            function(item) {

                                item.classList.add(
                                    "is-visible"
                                );

                            }
                        );
                    }



                    // =================================================
                    // FORM SUBMIT LOADING
                    //
                    // data-no-loading можно ставить на формы,
                    // которые не должны блокировать кнопку.
                    // =================================================

                    const forms =
                        document.querySelectorAll(
                            "form:not([data-no-loading])"
                        );


                    forms.forEach(
                        function(form) {

                            form.addEventListener(
                                "submit",
                                function() {

                                    if (
                                        !form.checkValidity()
                                    ) {
                                        return;
                                    }


                                    const submitButton =
                                        form.querySelector(
                                            'button[type="submit"], input[type="submit"]'
                                        );


                                    if (!submitButton) {
                                        return;
                                    }


                                    if (
                                        submitButton.dataset
                                            .awLoading
                                        ===
                                        "true"
                                    ) {
                                        return;
                                    }


                                    submitButton.dataset
                                        .awLoading =
                                        "true";


                                    submitButton.classList.add(
                                        "aw-button-loading"
                                    );


                                    if (
                                        submitButton
                                            .tagName
                                        ===
                                        "BUTTON"
                                    ) {
                                        submitButton.dataset
                                            .originalText =
                                            submitButton.innerHTML;


                                        submitButton.innerHTML =
                                            '<span class="aw-button-spinner"></span>'
                                            +
                                            '<span>Загрузка...</span>';
                                    }


                                    submitButton.disabled =
                                        true;

                                }
                            );

                        }
                    );



                    // =================================================
                    // IMAGE FADE-IN
                    // =================================================

                    const images =
                        document.querySelectorAll(
                            "img"
                        );


                    images.forEach(
                        function(image) {

                            image.classList.add(
                                "aw-image-loading"
                            );


                            function markLoaded() {

                                image.classList.remove(
                                    "aw-image-loading"
                                );


                                image.classList.add(
                                    "aw-image-loaded"
                                );

                            }


                            if (image.complete) {

                                markLoaded();

                            }
                            else {

                                image.addEventListener(
                                    "load",
                                    markLoaded,
                                    {
                                        once: true
                                    }
                                );


                                image.addEventListener(
                                    "error",
                                    markLoaded,
                                    {
                                        once: true
                                    }
                                );

                            }

                        }
                    );



                    // =================================================
                    // ACTIVE NAVBAR LINK
                    // =================================================

                    const currentPath =
                        window.location.pathname
                            .toLowerCase();


                    const navbarLinks =
                        document.querySelectorAll(
                            ".aw-navbar-links a"
                        );


                    navbarLinks.forEach(
                        function(link) {

                            const href =
                                link.getAttribute(
                                    "href"
                                );


                            if (!href) {
                                return;
                            }


                            const linkPath =
                                href
                                    .split("?")[0]
                                    .toLowerCase();


                            if (
                                linkPath === "/"
                                &&
                                currentPath === "/"
                            ) {
                                link.classList.add(
                                    "is-active"
                                );

                                return;
                            }


                            if (
                                linkPath !== "/"
                                &&
                                currentPath.startsWith(
                                    linkPath
                                )
                            ) {
                                link.classList.add(
                                    "is-active"
                                );
                            }

                        }
                    );



                    // =================================================
                    // CTRL / CMD + K
                    //
                    // Сам popup обрабатывается _SmartSearch,
                    // здесь только страховочная активация кнопки.
                    // =================================================

                    document.addEventListener(
                        "keydown",
                        function(event) {

                            if (
                                (
                                    event.ctrlKey
                                    ||
                                    event.metaKey
                                )
                                &&
                                event.key
                                    .toLowerCase()
                                ===
                                "k"
                            ) {
                                const searchButton =
                                    document.getElementById(
                                        "awSmartSearchButton"
                                    );


                                if (searchButton) {

                                    event.preventDefault();

                                    searchButton.click();

                                }
                            }

                        }
                    );

                }
            );

    </script>



    <!-- =========================================================
         PAGE SCRIPTS
         ========================================================= -->
    @await RenderSectionAsync(
            "Scripts",
            required: false
        )

</body>

</html>