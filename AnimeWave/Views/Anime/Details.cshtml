@model AnimeWave.Models.Anime

@using AnimeWave.Models

@{
    ViewData["Title"] = Model.Title;

    bool isFavorite =
        ViewBag.IsFavorite is bool favoriteValue
        && favoriteValue;

    var similarAnime =
        ViewBag.SimilarAnime as IEnumerable<Anime>
        ?? Enumerable.Empty<Anime>();

    var currentGenreIds =
        Model.AnimeGenres?
            .Select(ag => ag.GenreId)
            .ToHashSet()
        ?? new HashSet<int>();

    var genres =
        Model.AnimeGenres?
            .Where(ag => ag.Genre != null)
            .Select(ag => ag.Genre)
            .ToList()
        ?? new List<Genre>();

    var episodes =
        Model.Episodes?
            .OrderBy(e => e.EpisodeNumber)
            .ToList()
        ?? new List<Episode>();
}


<div class="aw-details">


    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="aw-details-hero">

        <div class="aw-details-bg">

            @if (!string.IsNullOrWhiteSpace(Model.BannerUrl))
            {
                <img src="@Model.BannerUrl"
                     alt=""
                     aria-hidden="true" />
            }

        </div>


        <div class="aw-details-bg-overlay"></div>

        <div class="aw-details-bg-bottom"></div>


        <div class="aw-details-hero-inner">


            <!-- POSTER -->

            <div class="aw-details-main-poster">

                @if (!string.IsNullOrWhiteSpace(Model.PosterUrl))
                {
                    <img src="@Model.PosterUrl"
                         alt="@Model.Title"
                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                    <div class="aw-details-poster-empty"
                         style="display:none;">
                        AW
                    </div>
                }
                else
                {
                    <div class="aw-details-poster-empty">
                        AW
                    </div>
                }


                <div class="aw-details-poster-score">

                    <span>★</span>

                    @Model.Rating.ToString("0.0")

                </div>

            </div>



            <!-- CONTENT -->

            <div class="aw-details-hero-content">

                <div class="aw-details-kicker">

                    <i></i>

                    ANIMEWAVE CATALOG

                </div>


                <h1>
                    @Model.Title
                </h1>


                @if (!string.IsNullOrWhiteSpace(Model.OriginalTitle))
                {
                    <p class="aw-details-original">

                        @Model.OriginalTitle

                    </p>
                }


                <!-- META -->

                <div class="aw-details-meta">

                    <span class="aw-details-meta-rating">

                        ★ @Model.Rating.ToString("0.0")

                    </span>


                    <i></i>


                    <span>
                        @Model.ReleaseYear
                    </span>


                    @if (!string.IsNullOrWhiteSpace(Model.AgeRating))
                    {
                        <i></i>

                        <span class="aw-details-age">
                            @Model.AgeRating
                        </span>
                    }


                    @if (Model.EpisodesCount > 0)
                    {
                        <i></i>

                        <span>
                            @Model.EpisodesCount серий
                        </span>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.Status))
                    {
                        <i></i>

                        <span class="aw-details-status">

                            <b></b>

                            @Model.Status

                        </span>
                    }

                </div>



                <!-- GENRES -->
                @if (genres.Any())
                {
                    <div class="aw-details-genres">

                        @foreach (var genre in genres)
                        {
                            <a asp-controller="Anime"
                               asp-action="Index"
                               asp-route-genreId="@genre.Id">

                                @genre.Name

                            </a>
                        }

                    </div>
                }



                <!-- DESCRIPTION -->

                <p class="aw-details-hero-description">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Описание для этого аниме пока не добавлено."
                        : Model.Description)

                </p>



                <!-- ACTIONS -->

                <div class="aw-details-actions">

                    @if (episodes.Any())
                    {
                        var firstEpisode = episodes.First();

                        <a asp-controller="Anime"
                           asp-action="Watch"
                           asp-route-animeId="@Model.Id"
                           asp-route-episodeId="@firstEpisode.Id"
                           class="aw-details-primary">

                            <span class="aw-details-play">
                                ▶
                            </span>

                            Смотреть

                        </a>
                    }
                    else
                    {
                        <a href="#aboutAnime"
                           class="aw-details-primary">

                            <span>
                                ↓
                            </span>

                            Подробнее

                        </a>
                    }


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        if (isFavorite)
                        {
                            <form asp-controller="Favorites"
                                  asp-action="Remove"
                                  method="post"
                                  class="aw-details-favorite-form"
                                  data-no-loading>

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="animeId"
                                       value="@Model.Id" />


                                <button type="submit"
                                        class="aw-details-secondary is-active">

                                    <span>♥</span>

                                    В избранном

                                </button>

                            </form>
                        }
                        else
                        {
                            <form asp-controller="Favorites"
                                  asp-action="Add"
                                  method="post"
                                  class="aw-details-favorite-form"
                                  data-no-loading>

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="animeId"
                                       value="@Model.Id" />


                                <button type="submit"
                                        class="aw-details-secondary">

                                    <span>♡</span>

                                    В избранное

                                </button>

                            </form>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path"
                           class="aw-details-secondary">

                            <span>♡</span>

                            В избранное

                        </a>
                    }

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         ABOUT
         ========================================================= -->

    <main class="aw-details-body">


        <section class="aw-details-about"
                 id="aboutAnime">

            <div class="aw-details-section-title">

                <div>

                    <span>
                        ABOUT
                    </span>

                    <h2>
                        Об аниме
                    </h2>

                </div>

            </div>


            <div class="aw-details-about-grid">


                <!-- DESCRIPTION -->

                <article class="aw-details-description-card">

                    <div class="aw-details-description-number">
                        01
                    </div>


                    <h3>
                        Описание
                    </h3>


                    <p>

                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "Описание для этого аниме пока не добавлено."
                            : Model.Description)

                    </p>

                </article>



                <!-- FACTS -->

                <aside class="aw-details-facts">


                    <div class="aw-details-fact">

                        <span>
                            ГОД
                        </span>

                        <strong>
                            @Model.ReleaseYear
                        </strong>

                    </div>


                    <div class="aw-details-fact">

                        <span>
                            РЕЙТИНГ
                        </span>

                        <strong class="rating">
                            ★ @Model.Rating.ToString("0.0")
                        </strong>

                    </div>


                    <div class="aw-details-fact">

                        <span>
                            СЕРИИ
                        </span>

                        <strong>
                            @Model.EpisodesCount
                        </strong>

                    </div>


                    <div class="aw-details-fact">

                        <span>
                            ВОЗРАСТ
                        </span>

                        <strong>

                            @(string.IsNullOrWhiteSpace(Model.AgeRating)
                                ? "—"
                                : Model.AgeRating)

                        </strong>

                    </div>


                    <div class="aw-details-fact aw-details-fact-wide">

                        <span>
                            СТАТУС
                        </span>

                        <strong>

                            @(string.IsNullOrWhiteSpace(Model.Status)
                                ? "Не указан"
                                : Model.Status)

                        </strong>

                    </div>

                </aside>

            </div>

        </section>



        <!-- =====================================================
             EPISODES
             ===================================================== -->
        @if (episodes.Any())
        {
            <section class="aw-details-episodes">

                <div class="aw-details-section-title">

                    <div>

                        <span>
                            WATCH
                        </span>

                        <h2>
                            Серии
                        </h2>

                    </div>


                    <small>
                        @episodes.Count эп.
                    </small>

                </div>


                <div class="aw-details-episode-list">

                    @foreach (var episode in episodes)
                    {
                        <a asp-controller="Anime"
                           asp-action="Watch"
                           asp-route-animeId="@Model.Id"
                           asp-route-episodeId="@episode.Id"
                           class="aw-details-episode">


                            <div class="aw-details-episode-index">

                                @episode.EpisodeNumber
                                .ToString("00")

                            </div>


                            <div class="aw-details-episode-thumb">

                                @if (!string.IsNullOrWhiteSpace(episode.ThumbnailUrl))
                                {
                                    <img src="@episode.ThumbnailUrl"
                                         alt="@episode.Title"
                                         loading="lazy" />
                                }


                                <div class="aw-details-episode-play">

                                    ▶

                                </div>

                            </div>


                            <div class="aw-details-episode-text">

                                <span>
                                    EPISODE @episode.EpisodeNumber
                                </span>


                                <h3>
                                    @episode.Title
                                </h3>


                                @if (!string.IsNullOrWhiteSpace(episode.Description))
                                {
                                    <p>
                                        @episode.Description
                                    </p>
                                }

                            </div>


                            <div class="aw-details-episode-go">

                                →

                            </div>

                        </a>
                    }

                </div>

            </section>
        }



        <!-- =====================================================
             SIMILAR ANIME
             ===================================================== -->
        @if (similarAnime.Any())
        {
            <section class="aw-similar">


                <!-- HEADER -->

                <div class="aw-similar-header">

                    <div>

                        <span class="aw-similar-kicker">

                            DISCOVER MORE

                        </span>


                        <h2>

                            Похожие
                            <strong>тайтлы</strong>

                        </h2>


                        <p>
                            Подбираем аниме по совпадающим жанрам
                            и рейтингу.
                        </p>

                    </div>


                    <a asp-controller="Anime"
                       asp-action="Index"
                       class="aw-similar-all">

                        Весь каталог

                        <span>→</span>

                    </a>

                </div>



                <!-- GRID -->

                <div class="aw-similar-grid">

                    @foreach (var similar in similarAnime)
                    {
                        int matches =
                            similar.AnimeGenres?
                                .Count(
                                    ag =>
                                        currentGenreIds.Contains(
                                            ag.GenreId
                                        )
                                )
                            ?? 0;


                        <article class="aw-similar-card">


                            <a asp-controller="Anime"
                               asp-action="Details"
                               asp-route-id="@similar.Id"
                               class="aw-similar-poster">


                                @if (!string.IsNullOrWhiteSpace(similar.PosterUrl))
                                {
                                    <img src="@similar.PosterUrl"
                                         alt="@similar.Title"
                                         loading="lazy"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />


                                    <div class="aw-similar-placeholder"
                                         style="display:none;">

                                        AW

                                    </div>
                                }
                                else
                                {
                                    <div class="aw-similar-placeholder">

                                        AW

                                    </div>
                                }



                                <!-- TOP BADGES -->

                                <div class="aw-similar-poster-top">

                                    <span class="aw-similar-score">

                                        ★ @similar.Rating.ToString("0.0")

                                    </span>


                                    @if (!string.IsNullOrWhiteSpace(similar.AgeRating))
                                    {
                                        <span class="aw-similar-age">

                                            @similar.AgeRating

                                        </span>
                                    }

                                </div>



                                <!-- MATCH -->
                                @if (matches > 0)
                                {
                                    <span class="aw-similar-match">

                                        <i></i>

                                        @matches совп.

                                    </span>
                                }



                                <!-- HOVER -->

                                <div class="aw-similar-hover">

                                    <div class="aw-similar-hover-play">

                                        ▶

                                    </div>


                                    <span>
                                        Открыть
                                    </span>

                                </div>


                                <div class="aw-similar-poster-shadow"></div>

                            </a>



                            <!-- CARD INFO -->

                            <div class="aw-similar-info">

                                <a asp-controller="Anime"
                                   asp-action="Details"
                                   asp-route-id="@similar.Id"
                                   class="aw-similar-title">

                                    @similar.Title

                                </a>


                                @if (!string.IsNullOrWhiteSpace(similar.OriginalTitle))
                                {
                                    <p class="aw-similar-original">

                                        @similar.OriginalTitle

                                    </p>
                                }


                                <div class="aw-similar-meta">

                                    <span>
                                        @similar.ReleaseYear
                                    </span>


                                    @if (similar.EpisodesCount > 0)
                                    {
                                        <i></i>

                                        <span>
                                            @similar.EpisodesCount серий
                                        </span>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(similar.Status))
                                    {
                                        <i></i>

                                        <span>
                                            @similar.Status
                                        </span>
                                    }

                                </div>



                                @if (
                                    similar.AnimeGenres != null
                                    &&
                                    similar.AnimeGenres.Any()
                                )
                                {
                                    <div class="aw-similar-genres">

                                        @foreach (
                                            var animeGenre
                                            in similar.AnimeGenres
                                                .Where(ag => ag.Genre != null)
                                                .Take(3)
                                        )
                                        {
                                            bool match =
                                                currentGenreIds.Contains(
                                                    animeGenre.GenreId
                                                );


                                            <span class="@(match ? "is-match" : "")">

                                                @animeGenre.Genre.Name

                                            </span>
                                        }

                                    </div>
                                }

                            </div>

                        </article>
                    }

                </div>

            </section>
        }

    </main>

</div>



<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .aw-details,
    .aw-details * {
        box-sizing: border-box;
    }


    .aw-details {
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        background: #080a0f;
        color: #fff;
    }


        .aw-details a {
            text-decoration: none;
        }



    /* =========================================================
           HERO
           ========================================================= */

    .aw-details-hero {
        position: relative;
        min-height: 720px;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
        background: #080a0f;
    }


    .aw-details-bg {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }


        .aw-details-bg img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center 25%;
            filter: saturate(.88) brightness(.65);
            transform: scale(1.025);
            animation: awDetailsImageIn 1.4s cubic-bezier(.22,1,.36,1) both;
        }


    @@keyframes awDetailsImageIn {

        from {
            opacity: .35;
            transform: scale(1.08);
        }

        to {
            opacity: 1;
            transform: scale(1.025);
        }
    }


    .aw-details-bg-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 90deg, rgba(8,10,15,.99) 0%, rgba(8,10,15,.90) 25%, rgba(8,10,15,.55) 54%, rgba(8,10,15,.24) 78%, rgba(8,10,15,.48) 100% );
    }


    .aw-details-bg-bottom {
        position: absolute;
        inset: 0;
        background: linear-gradient( 180deg, rgba(8,10,15,.35) 0%, transparent 32%, rgba(8,10,15,.32) 68%, #080a0f 100% );
    }


    .aw-details-hero-inner {
        position: relative;
        z-index: 3;
        width: min( 1440px, calc(100% - 64px) );
        margin: 0 auto;
        padding: 150px 0 68px;
        display: grid;
        grid-template-columns: 235px minmax(0,760px);
        align-items: end;
        gap: 45px;
    }



    /* =========================================================
           MAIN POSTER
           ========================================================= */

    .aw-details-main-poster {
        position: relative;
        width: 235px;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.11);
        border-radius: 18px;
        background: #11141c;
        box-shadow: 0 35px 80px rgba(0,0,0,.55);
    }


        .aw-details-main-poster > img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }


    .aw-details-poster-empty {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient( circle at 40% 30%, rgba(139,92,246,.22), transparent 40% ), #11141c;
        color: rgba(167,139,250,.7);
        font-size: 28px;
        font-weight: 900;
    }


    .aw-details-poster-score {
        position: absolute;
        right: 10px;
        bottom: 10px;
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 7px 9px;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 8px;
        background: rgba(7,9,14,.85);
        color: #fff;
        font-size: 9px;
        font-weight: 800;
        backdrop-filter: blur(12px);
    }


        .aw-details-poster-score span {
            color: #fbbf24;
        }



    /* =========================================================
           HERO CONTENT
           ========================================================= */

    .aw-details-kicker {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        color: #a78bfa;
        font-size: 7px;
        font-weight: 900;
        letter-spacing: 2.2px;
    }


        .aw-details-kicker i {
            width: 18px;
            height: 1px;
            display: block;
            background: #8b5cf6;
        }


    .aw-details-hero-content h1 {
        max-width: 850px;
        margin: 0 0 8px;
        color: #fff;
        font-size: clamp( 43px, 5vw, 72px );
        line-height: .96;
        letter-spacing: -3px;
        text-wrap: balance;
    }


    .aw-details-original {
        margin: 0 0 19px;
        color: rgba(255,255,255,.42);
        font-size: 12px;
        font-weight: 500;
    }


    .aw-details-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 17px;
        color: rgba(220,224,230,.66);
        font-size: 8px;
        font-weight: 700;
    }


        .aw-details-meta > i {
            width: 3px;
            height: 3px;
            display: block;
            border-radius: 50%;
            background: rgba(255,255,255,.22);
        }


    .aw-details-meta-rating {
        color: #fbbf24;
    }


    .aw-details-age {
        padding: 3px 6px;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 4px;
    }


    .aw-details-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }


        .aw-details-status b {
            width: 5px;
            height: 5px;
            display: block;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 10px rgba(34,197,94,.55);
        }



    /* =========================================================
           HERO GENRES
           ========================================================= */

    .aw-details-genres {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 20px;
    }


        .aw-details-genres a {
            display: inline-flex;
            padding: 6px 9px;
            border: 1px solid rgba(139,92,246,.14);
            border-radius: 6px;
            background: rgba(139,92,246,.06);
            color: #b9a5ed;
            font-size: 7px;
            font-weight: 700;
            transition: color .2s ease, background .2s ease, border-color .2s ease;
        }


            .aw-details-genres a:hover {
                border-color: rgba(139,92,246,.36);
                background: rgba(139,92,246,.14);
                color: #fff;
            }



    /* =========================================================
           HERO DESCRIPTION
           ========================================================= */

    .aw-details-hero-description {
        max-width: 720px;
        display: -webkit-box;
        margin: 0 0 26px;
        overflow: hidden;
        color: rgba(224,227,233,.66);
        font-size: 10px;
        line-height: 1.8;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
    }



    /* =========================================================
           BUTTONS
           ========================================================= */

    .aw-details-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
    }


    .aw-details-favorite-form {
        margin: 0;
    }


    .aw-details-primary,
    .aw-details-secondary {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 17px;
        border-radius: 9px;
        font-family: inherit;
        font-size: 8px;
        font-weight: 800;
        cursor: pointer;
        transition: transform .2s ease, background .2s ease, border-color .2s ease, color .2s ease;
    }


    .aw-details-primary {
        border: 0;
        background: #fff;
        color: #080a0f;
    }


        .aw-details-primary:hover {
            color: #080a0f;
            transform: translateY(-2px);
        }


    .aw-details-secondary {
        border: 1px solid rgba(255,255,255,.10);
        background: rgba(255,255,255,.055);
        color: #fff;
        backdrop-filter: blur(10px);
    }


        .aw-details-secondary:hover {
            border-color: rgba(139,92,246,.30);
            background: rgba(139,92,246,.12);
            color: #fff;
            transform: translateY(-2px);
        }


        .aw-details-secondary.is-active {
            border-color: rgba(139,92,246,.28);
            background: rgba(139,92,246,.13);
            color: #c4b5fd;
        }



    /* =========================================================
           BODY
           ========================================================= */

    .aw-details-body {
        width: min( 1440px, calc(100% - 64px) );
        margin: 0 auto;
    }


    .aw-details-section-title {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }


        .aw-details-section-title span {
            display: block;
            margin-bottom: 5px;
            color: #8b5cf6;
            font-size: 7px;
            font-weight: 900;
            letter-spacing: 2px;
        }


        .aw-details-section-title h2 {
            margin: 0;
            color: #f6f6f7;
            font-size: 25px;
            letter-spacing: -1px;
        }


        .aw-details-section-title small {
            color: #464d58;
            font-size: 7px;
            font-weight: 800;
        }



    /* =========================================================
           ABOUT
           ========================================================= */

    .aw-details-about {
        padding: 48px 0 54px;
    }


    .aw-details-about-grid {
        display: grid;
        grid-template-columns: minmax(0,1fr) 360px;
        gap: 18px;
    }


    .aw-details-description-card {
        position: relative;
        min-height: 230px;
        padding: 27px 30px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.045);
        border-radius: 16px;
        background: linear-gradient( 145deg, rgba(17,20,28,.92), rgba(11,14,20,.90) );
    }


    .aw-details-description-number {
        position: absolute;
        top: 19px;
        right: 22px;
        color: rgba(255,255,255,.05);
        font-size: 45px;
        font-weight: 900;
        letter-spacing: -3px;
    }


