@model IEnumerable<AnimeWave.Models.Anime>

@using AnimeWave.Models
@using AnimeWave.ViewModels

@{
    ViewData["Title"] = "Каталог";


    // =========================================================
    // DATA
    // =========================================================

    var animeList =
        Model?.ToList()
        ?? new List<Anime>();


    var genres =
        ViewBag.Genres as IEnumerable<Genre>
        ?? Enumerable.Empty<Genre>();



    // =========================================================
    // FILTER STATE
    // =========================================================

    string search =
        ViewBag.Search?.ToString()
        ?? string.Empty;


    int? genreId =
        ViewBag.GenreId != null
            ? Convert.ToInt32(ViewBag.GenreId)
            : null;


    decimal? minRating =
        ViewBag.MinRating != null
            ? Convert.ToDecimal(ViewBag.MinRating)
            : null;


    string sort =
        ViewBag.Sort?.ToString()
        ?? "rating";


    int currentPage =
        ViewBag.CurrentPage != null
            ? Convert.ToInt32(ViewBag.CurrentPage)
            : 1;


    int totalPages =
        ViewBag.TotalPages != null
            ? Convert.ToInt32(ViewBag.TotalPages)
            : 1;


    int pageSize =
        ViewBag.PageSize != null
            ? Convert.ToInt32(ViewBag.PageSize)
            : 12;


    int totalItems =
        ViewBag.TotalItems != null
            ? Convert.ToInt32(ViewBag.TotalItems)
            : animeList.Count;



    // =========================================================
    // POPULARITY
    // =========================================================

    var popularity =
        ViewBag.Popularity
            as Dictionary<int, AnimePopularityViewModel>
        ?? new Dictionary<int, AnimePopularityViewModel>();



    // =========================================================
    // ACTIVE FILTERS
    // =========================================================

    bool hasSearch =
        !string.IsNullOrWhiteSpace(search);


    bool hasGenre =
        genreId.HasValue;


    bool hasRating =
        minRating.HasValue;


    bool hasFilters =
        hasSearch
        ||
        hasGenre
        ||
        hasRating;


    string? selectedGenreName =
        hasGenre
            ? genres
                .FirstOrDefault(
                    g => g.Id == genreId
                )
                ?.Name
            : null;



    // =========================================================
    // PAGINATION NUMBERS
    // =========================================================

    var paginationPages =
        new List<int>();


    for (
        int pageNumber = 1;
        pageNumber <= totalPages;
        pageNumber++
    )
    {
        bool showPage =
            pageNumber == 1

            ||

            pageNumber == totalPages

            ||

            Math.Abs(
                pageNumber - currentPage
            )
            <= 2;


        if (showPage)
        {
            paginationPages.Add(
                pageNumber
            );
        }
    }
}


<div class="aw-catalog">


    <!-- =========================================================
         HERO
         ========================================================= -->

    <section class="aw-catalog-hero">

        <div class="aw-catalog-hero-glow">
        </div>


        <div class="aw-catalog-hero-inner">

            <div class="aw-catalog-kicker">

                <span>
                </span>

                EXPLORE ANIMEWAVE

            </div>


            <h1>

                Каталог
                <strong>
                    аниме
                </strong>

            </h1>


            <p>

                Находи новые истории, фильтруй тайтлы
                по жанру и рейтингу и открывай самое
                популярное в AnimeWave.

            </p>

        </div>

    </section>



    <!-- =========================================================
         CONTENT
         ========================================================= -->

    <main class="aw-catalog-inner">


        <!-- =====================================================
             FILTER PANEL
             ===================================================== -->

        <section class="aw-catalog-filter-panel">


            <form asp-controller="Anime"
                  asp-action="Index"
                  method="get"
                  class="aw-catalog-filter-form">


                <!-- =================================================
                     SEARCH
                     ================================================= -->

                <div class="aw-catalog-filter-field aw-catalog-search-field">

                    <label for="catalogSearch">

                        ПОИСК

                    </label>


                    <div class="aw-catalog-search-input">

                        <svg width="17"
                             height="17"
                             viewBox="0 0 24 24"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">

                            <circle cx="11"
                                    cy="11"
                                    r="6.5"
                                    stroke="currentColor"
                                    stroke-width="1.7" />

                            <path d="M16 16L20 20"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round" />

                        </svg>


                        <input type="text"
                               id="catalogSearch"
                               name="search"
                               value="@search"
                               placeholder="Название аниме..." />

                    </div>

                </div>



                <!-- =================================================
                     GENRE
                     ================================================= -->

                <div class="aw-catalog-filter-field">

                    <label for="catalogGenre">

                        ЖАНР

                    </label>


                    <select id="catalogGenre"
                            name="genreId">

                        <option value="">

                            Все жанры

                        </option>


                        @foreach (var genre in genres)
                        {
                            <option value="@genre.Id"
                                    selected="@(genreId == genre.Id ? "selected" : null)">

                                @genre.Name

                            </option>
                        }

                    </select>

                </div>



                <!-- =================================================
                     MIN RATING
                     ================================================= -->

                <div class="aw-catalog-filter-field">

                    <label for="catalogRating">

                        РЕЙТИНГ

                    </label>


                    <select id="catalogRating"
                            name="minRating">

                        <option value="">

                            Любой

                        </option>


                        <option value="9"
                                selected="@(minRating == 9 ? "selected" : null)">

                            ★ 9.0+

                        </option>


                        <option value="8"
                                selected="@(minRating == 8 ? "selected" : null)">

                            ★ 8.0+

                        </option>


                        <option value="7"
                                selected="@(minRating == 7 ? "selected" : null)">

                            ★ 7.0+

                        </option>


                        <option value="6"
                                selected="@(minRating == 6 ? "selected" : null)">

                            ★ 6.0+

                        </option>

                    </select>

                </div>



                <!-- =================================================
                     SORT
                     ================================================= -->

                <div class="aw-catalog-filter-field">

                    <label for="catalogSort">

                        СОРТИРОВКА

                    </label>


                    <select id="catalogSort"
                            name="sort">

                        <option value="rating"
                                selected="@(sort == "rating" ? "selected" : null)">

                            Лучший рейтинг

                        </option>


                        <option value="new"
                                selected="@(sort == "new" ? "selected" : null)">

                            Сначала новые

                        </option>


                        <option value="old"
                                selected="@(sort == "old" ? "selected" : null)">

                            Сначала старые

                        </option>


                        <option value="title"
                                selected="@(sort == "title" ? "selected" : null)">

                            По названию

                        </option>


                        <option value="rating-low"
                                selected="@(sort == "rating-low" ? "selected" : null)">

                            Рейтинг по возрастанию

                        </option>

                    </select>

                </div>



                <!-- =================================================
                     PAGE SIZE
                     ================================================= -->

                <div class="aw-catalog-filter-field aw-catalog-size-field">

                    <label for="catalogPageSize">

                        НА СТРАНИЦЕ

                    </label>


                    <select id="catalogPageSize"
                            name="pageSize">

                        <option value="12"
                                selected="@(pageSize == 12 ? "selected" : null)">

                            12

                        </option>


                        <option value="18"
                                selected="@(pageSize == 18 ? "selected" : null)">

                            18

                        </option>

                    </select>

                </div>



                <!-- =================================================
                     SUBMIT
                     ================================================= -->

                <button type="submit"
                        class="aw-catalog-filter-submit">

                    <span>
                        Найти
                    </span>


                    <svg width="15"
                         height="15"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">

                        <path d="M5 12H19"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round" />


                        <path d="M14 7L19 12L14 17"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round" />

                    </svg>

                </button>

            </form>

        </section>



        <!-- =====================================================
             RESULTS HEADER
             ===================================================== -->

        <section class="aw-catalog-results-header">

            <div>

                <span class="aw-catalog-results-kicker">

                    LIBRARY

                </span>


                <h2>

                    Найдено
                    <strong>
                        @totalItems
                    </strong>

                </h2>

            </div>



            <div class="aw-catalog-results-page">

                Страница

                <strong>
                    @currentPage
                </strong>

                из

                <strong>
                    @totalPages
                </strong>

            </div>

        </section>



        <!-- =====================================================
             ACTIVE FILTERS
             ===================================================== -->
        @if (hasFilters)
        {
            <section class="aw-catalog-active-filters">


                <span class="aw-catalog-active-label">

                    АКТИВНЫЕ ФИЛЬТРЫ

                </span>



                <div class="aw-catalog-filter-chips">


                    @if (hasSearch)
                    {
                        <a asp-controller="Anime"
                           asp-action="Index"
                           asp-route-genreId="@genreId"
                           asp-route-minRating="@minRating"
                           asp-route-sort="@sort"
                           asp-route-pageSize="@pageSize"
                           class="aw-catalog-filter-chip">

                            <span>
                                Поиск:
                            </span>

                            @search

                            <strong>
                                ×
                            </strong>

                        </a>
                    }



                    @if (hasGenre)
                    {
                        <a asp-controller="Anime"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-minRating="@minRating"
                           asp-route-sort="@sort"
                           asp-route-pageSize="@pageSize"
                           class="aw-catalog-filter-chip">

                            <span>
                                Жанр:
                            </span>

                            @(selectedGenreName ?? "Выбранный")

                            <strong>
                                ×
                            </strong>

                        </a>
                    }



                    @if (hasRating)
                    {
                        <a asp-controller="Anime"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-genreId="@genreId"
                           asp-route-sort="@sort"
                           asp-route-pageSize="@pageSize"
                           class="aw-catalog-filter-chip">

                            <span>
                                Рейтинг:
                            </span>

                            ★ @minRating?.ToString("0.0")+

                            <strong>
                                ×
                            </strong>

                        </a>
                    }



                    <a asp-controller="Anime"
                       asp-action="Index"
                       asp-route-sort="@sort"
                       asp-route-pageSize="@pageSize"
                       class="aw-catalog-clear-filters">

                        Сбросить всё

                    </a>

                </div>

            </section>
        }



        <!-- =====================================================
             ANIME GRID
             ===================================================== -->
        @if (animeList.Any())
        {
            <section class="aw-catalog-grid">

                @foreach (var anime in animeList)
                {
                    var animeGenres =
                        anime.AnimeGenres?
                            .Where(
                                ag => ag.Genre != null
                            )
                            .Take(3)
                            .ToList()
                        ?? new List<AnimeGenre>();


                    AnimePopularityViewModel? animePopularity =
                        popularity.TryGetValue(
                            anime.Id,
                            out var popularityValue
                        )
                            ? popularityValue
                            : null;



                    <article class="aw-anime-card">


                        <!-- =========================================
                             POSTER
                             ========================================= -->

                        <a asp-controller="Anime"
                           asp-action="Details"
                           asp-route-id="@anime.Id"
                           class="aw-anime-card-poster">


                            <!-- POPULARITY -->
                            @if (animePopularity != null)
                            {
                                <partial name="_AnimePopularityBadges"
                                         model="animePopularity" />
                            }



                            <!-- IMAGE -->
                            @if (!string.IsNullOrWhiteSpace(
                                                            anime.PosterUrl))
                            {
                                <img src="@anime.PosterUrl"
                                     alt="@anime.Title"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />


                                <div class="aw-anime-card-placeholder"
                                     style="display:none;">

                                    AW

                                </div>
                            }
                            else
                            {
                                <div class="aw-anime-card-placeholder">

                                    AW

                                </div>
                            }



                            <!-- TOP RIGHT -->

                            <div class="aw-anime-card-top-right">

                                <span class="aw-anime-card-rating">

                                    ★

                                    @anime.Rating.ToString("0.0")

                                </span>



                                @if (!string.IsNullOrWhiteSpace(
                                    anime.AgeRating))
                                {
                                    <span class="aw-anime-card-age">

                                        @anime.AgeRating

                                    </span>
                                }

                            </div>



                            <!-- OVERLAY -->

                            <div class="aw-anime-card-poster-overlay">
                            </div>



                            <!-- HOVER -->

                            <div class="aw-anime-card-hover">

                                <span class="aw-anime-card-play">

                                    ▶

                                </span>


                                <strong>

                                    Подробнее

                                </strong>

                            </div>

                        </a>



                        <!-- =========================================
                             CONTENT
                             ========================================= -->

                        <div class="aw-anime-card-content">


                            <!-- TITLE -->

                            <a asp-controller="Anime"
                               asp-action="Details"
                               asp-route-id="@anime.Id"
                               class="aw-anime-card-title">

                                @anime.Title

                            </a>



                            <!-- ORIGINAL -->
                            @if (!string.IsNullOrWhiteSpace(
                                                            anime.OriginalTitle))
                            {
                                <p class="aw-anime-card-original">

                                    @anime.OriginalTitle

                                </p>
                            }



                            <!-- META -->

                            <div class="aw-anime-card-meta">

                                <span>

                                    @anime.ReleaseYear

                                </span>



                                @if (anime.EpisodesCount > 0)
                                {
                                    <i>
                                    </i>


                                    <span>

                                        @anime.EpisodesCount серий

                                    </span>
                                }



                                @if (!string.IsNullOrWhiteSpace(
                                    anime.Status))
                                {
                                    <i>
                                    </i>


                                    <span class="aw-anime-card-status">

                                        <b>
                                        </b>

                                        @anime.Status

                                    </span>
                                }

                            </div>



                            <!-- GENRES -->
                            @if (animeGenres.Any())
                            {
                                <div class="aw-anime-card-genres">

                                    @foreach (var animeGenre in animeGenres)
                                    {
                                        <a asp-controller="Anime"
                                           asp-action="Index"
                                           asp-route-genreId="@animeGenre.GenreId">

                                            @animeGenre.Genre.Name

                                        </a>
                                    }

                                </div>
                            }



                            <!-- POPULARITY MINI STATS -->
                            @if (
                                                            animePopularity != null
                                                            &&
                                                            animePopularity.PopularityScore > 0
                                                        )
                            {
                                <div class="aw-anime-card-popularity">


                                    <span title="Открытия страницы">

                                        <i>
                                            ◉
                                        </i>

                                        @animePopularity.OpenCount

                                    </span>


                                    <span title="В избранном">

                                        <i>
                                            ♥
                                        </i>

                                        @animePopularity.FavoritesCount

                                    </span>


                                    <span title="Уникальные зрители">

                                        <i>
                                            ▶
                                        </i>

                                        @animePopularity.UniqueViewersCount

                                    </span>

                                </div>
                            }

                        </div>

                    </article>
                }

            </section>
        }

        else
        {
            <!-- =================================================
                 EMPTY
                 ================================================= -->

            <section class="aw-catalog-empty">

                <div class="aw-catalog-empty-icon">

                    ◇

                </div>


                <span>
                    NO RESULTS
                </span>


                <h2>

                    Ничего не найдено

                </h2>


                <p>

                    Попробуйте изменить поисковый запрос,
                    жанр или минимальный рейтинг.

                </p>


                <a asp-controller="Anime"
                   asp-action="Index">

                    Сбросить фильтры

                </a>

            </section>
        }



        <!-- =====================================================
             PAGINATION
             ===================================================== -->
        @if (totalPages > 1)
        {
            <nav class="aw-pagination"
                 aria-label="Навигация по каталогу">


                <!-- =================================================
                     PREVIOUS
                     ================================================= -->
                @if (currentPage > 1)
                {
                    <a asp-controller="Anime"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-genreId="@genreId"
                       asp-route-minRating="@minRating"
                       asp-route-sort="@sort"
                       asp-route-pageSize="@pageSize"
                       asp-route-page="@(currentPage - 1)"
                       class="aw-pagination-arrow">

                        <span>
                            ←
                        </span>

                        Назад

                    </a>
                }
                else
                {
                    <span class="aw-pagination-arrow is-disabled">

                        <span>
                            ←
                        </span>

                        Назад

                    </span>
                }



                <!-- =================================================
                     NUMBERS
                     ================================================= -->

                <div class="aw-pagination-pages">

                    @{
                        int previousRenderedPage = 0;
                    }


                    @foreach (int pageNumber in paginationPages)
                    {
                        if (
                            previousRenderedPage > 0
                            &&
                            pageNumber - previousRenderedPage > 1
                        )
                        {
                            <span class="aw-pagination-dots">

                                ...

                            </span>
                        }


                        if (pageNumber == currentPage)
                        {
                            <span class="aw-pagination-number is-active">

                                @pageNumber

                            </span>
                        }
                        else
                        {
                            <a asp-controller="Anime"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-genreId="@genreId"
                               asp-route-minRating="@minRating"
                               asp-route-sort="@sort"
                               asp-route-pageSize="@pageSize"
                               asp-route-page="@pageNumber"
                               class="aw-pagination-number">

                                @pageNumber

                            </a>
                        }


                        previousRenderedPage =
                            pageNumber;
                    }

                </div>



                <!-- =================================================
                     NEXT
                     ================================================= -->
                @if (currentPage < totalPages)
                {
                    <a asp-controller="Anime"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-genreId="@genreId"
                       asp-route-minRating="@minRating"
                       asp-route-sort="@sort"
                       asp-route-pageSize="@pageSize"
                       asp-route-page="@(currentPage + 1)"
                       class="aw-pagination-arrow">

                        Вперёд

                        <span>
                            →
                        </span>

                    </a>
                }
                else
                {
                    <span class="aw-pagination-arrow is-disabled">

                        Вперёд

                        <span>
                            →
                        </span>

                    </span>
                }

            </nav>
        }

    </main>

</div>



<style>

    /* =========================================================
           CATALOG
           ========================================================= */

    .aw-catalog,
    .aw-catalog * {
        box-sizing: border-box;
    }


    .aw-catalog {
        min-height: 100vh;
        overflow-x: hidden;
        background: #080a0f;
        color: #fff;
    }


        .aw-catalog a {
            text-decoration: none;
        }



    /* =========================================================
           HERO
           ========================================================= */

    .aw-catalog-hero {
        position: relative;
        overflow: hidden;
        padding: 142px 0 55px;
        border-bottom: 1px solid rgba(255,255,255,.035);
        background: radial-gradient( circle at 74% 20%, rgba( var(--aw-accent-rgb, 139,92,246), .09 ), transparent 34% ), linear-gradient( 180deg, #0b0d13, #080a0f );
    }


    .aw-catalog-hero-glow {
        position: absolute;
        width: 500px;
        height: 300px;
        top: -180px;
        left: 15%;
        border-radius: 50%;
        background: rgba( var(--aw-accent-rgb, 139,92,246), .08 );
        filter: blur(110px);
    }


    .aw-catalog-hero-inner {
        position: relative;
        width: min( 1440px, calc(100% - 64px) );
        margin: 0 auto;
    }


    .aw-catalog-kicker {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        color: var(--aw-accent-soft, #a78bfa);
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 2.2px;
    }


        .aw-catalog-kicker > span {
            width: 19px;
            height: 1px;
            background: var(--aw-accent, #8b5cf6);
        }


    .aw-catalog-hero h1 {
        margin: 0 0 12px;
        color: #f7f7f8;
        font-size: clamp( 42px, 5vw, 68px );
        font-weight: 900;
        line-height: .98;
        letter-spacing: -3px;
    }


        .aw-catalog-hero h1 strong {
            color: var(--aw-accent-soft, #a78bfa);
            font-weight: 900;
        }


    .aw-catalog-hero p {
        max-width: 640px;
        margin: 0;
        color: #747d89;
        font-size: 15px;
        line-height: 1.75;
    }



    /* =========================================================
           INNER
           ========================================================= */

    .aw-catalog-inner {
        width: min( 1440px, calc(100% - 64px) );
        margin: 0 auto;
        padding: 30px 0 80px;
    }



    /* =========================================================
           FILTER PANEL
           ========================================================= */

    .aw-catalog-filter-panel {
        margin-bottom: 32px;
        padding: 17px;
        border: 1px solid rgba(255,255,255,.045);
        border-radius: 14px;
        background: linear-gradient( 145deg, rgba(17,20,28,.92), rgba(11,14,20,.90) );
        box-shadow: 0 18px 45px rgba(0,0,0,.12);
    }


    .aw-catalog-filter-form {
        display: grid;
        grid-template-columns: minmax(220px,1.55fr) minmax(140px,.8fr) minmax(115px,.6fr) minmax(175px,.9fr) 105px 105px;
        align-items: end;
        gap: 9px;
    }


    .aw-catalog-filter-field {
        min-width: 0;
    }


        .aw-catalog-filter-field > label {
            display: block;
            margin: 0 0 6px;
            color: #656e7a;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1.2px;
        }


        .aw-catalog-filter-field select,
        .aw-catalog-search-input {
            width: 100%;
            height: 43px;
            border: 1px solid rgba(255,255,255,.055);
            border-radius: 8px;
            background: rgba(255,255,255,.018);
            color: #dfe2e7;
            transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
        }


        .aw-catalog-filter-field select {
            padding: 0 11px;
            outline: none;
            color-scheme: dark;
            font-family: inherit;
            font-size: 13px;
            cursor: pointer;
        }


            .aw-catalog-filter-field select:focus,
            .aw-catalog-search-input:focus-within {
                border-color: rgba( var(--aw-accent-rgb, 139,92,246), .42 );
                background: rgba( var(--aw-accent-rgb, 139,92,246), .03 );
                box-shadow: 0 0 0 3px rgba( var(--aw-accent-rgb, 139,92,246), .055 );
            }



    /* =========================================================
           SEARCH
           ========================================================= */

    .aw-catalog-search-input {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 0 12px;
    }


        .aw-catalog-search-input svg {
            flex-shrink: 0;
            color: #5d6672;
        }


        .aw-catalog-search-input input {
            width: 100%;
            border: 0;
            outline: none;
            background: transparent;
            color: #e9ebef;
            font-family: inherit;
            font-size: 13px;
        }


            .aw-catalog-search-input input::placeholder {
                color: #4d5560;
            }



    /* =========================================================
           FILTER BUTTON
           ========================================================= */

    .aw-catalog-filter-submit {
        height: 43px;
        display: flex;
        align-items: center;
