@model IEnumerable<AnimeWave.Models.Anime>

@using AnimeWave.Models
@using System.Globalization

@{
    ViewData["Title"] = "Каталог";

    var animeList =
        Model?.ToList()
        ?? new List<Anime>();


    var genres =
        ViewBag.Genres as IEnumerable<Genre>
        ?? Enumerable.Empty<Genre>();


    string currentSearch =
        ViewBag.Search?.ToString()
        ?? string.Empty;


    string currentSort =
        ViewBag.Sort?.ToString()
        ?? "rating";


    int currentPage =
        Convert.ToInt32(
            ViewBag.CurrentPage ?? 1
        );


    int totalPages =
        Convert.ToInt32(
            ViewBag.TotalPages ?? 1
        );


    int pageSize =
        Convert.ToInt32(
            ViewBag.PageSize ?? 12
        );


    int totalItems =
        Convert.ToInt32(
            ViewBag.TotalItems ?? 0
        );


    int? currentGenreId = null;

    if (ViewBag.GenreId != null)
    {
        currentGenreId =
            Convert.ToInt32(
                ViewBag.GenreId
            );
    }


    decimal? currentMinRating = null;

    if (ViewBag.MinRating != null)
    {
        currentMinRating =
            Convert.ToDecimal(
                ViewBag.MinRating
            );
    }


    string? minRatingRoute =
        currentMinRating.HasValue
            ? currentMinRating.Value.ToString(
                CultureInfo.InvariantCulture
            )
            : null;


    bool hasFilters =
        !string.IsNullOrWhiteSpace(currentSearch)
        ||
        currentGenreId.HasValue
        ||
        currentMinRating.HasValue
        ||
        currentSort != "rating";
}


<section class="aw-catalog-page">

    <div class="aw-catalog-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <header class="aw-catalog-header">

            <div>

                <span class="aw-catalog-eyebrow">
                    EXPLORE ANIMEWAVE
                </span>


                <h1>
                    Каталог
                    <strong>аниме</strong>
                </h1>


                <p>
                    Найди следующий тайтл для просмотра.
                </p>

            </div>

        </header>



        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <form asp-controller="Anime"
              asp-action="Index"
              method="get"
              class="aw-catalog-filters"
              data-no-loading>


            <!-- SEARCH -->

            <div class="aw-catalog-search">

                <span class="aw-catalog-search-icon">
                    ⌕
                </span>


                <input type="text"
                       name="search"
                       value="@currentSearch"
                       placeholder="Поиск по названию..."
                       autocomplete="off" />

            </div>



            <!-- GENRE -->

            <div class="aw-catalog-filter-field">

                <label for="catalogGenre">
                    Жанр
                </label>


                <select id="catalogGenre"
                        name="genreId">

                    @if (!currentGenreId.HasValue)
                    {
                        <option value=""
                                selected>
                            Все жанры
                        </option>
                    }
                    else
                    {
                        <option value="">
                            Все жанры
                        </option>
                    }


                    @foreach (var genre in genres)
                    {
                        if (
                            currentGenreId.HasValue
                            &&
                            currentGenreId.Value == genre.Id
                        )
                        {
                            <option value="@genre.Id"
                                    selected>
                                @genre.Name
                            </option>
                        }
                        else
                        {
                            <option value="@genre.Id">
                                @genre.Name
                            </option>
                        }
                    }

                </select>

            </div>



            <!-- RATING -->

            <div class="aw-catalog-filter-field">

                <label for="catalogRating">
                    Рейтинг
                </label>


                <select id="catalogRating"
                        name="minRating">

                    @if (!currentMinRating.HasValue)
                    {
                        <option value=""
                                selected>
                            Любой
                        </option>
                    }
                    else
                    {
                        <option value="">
                            Любой
                        </option>
                    }


                    @if (currentMinRating == 7m)
                    {
                        <option value="7"
                                selected>
                            От 7.0
                        </option>
                    }
                    else
                    {
                        <option value="7">
                            От 7.0
                        </option>
                    }


                    @if (currentMinRating == 8m)
                    {
                        <option value="8"
                                selected>
                            От 8.0
                        </option>
                    }
                    else
                    {
                        <option value="8">
                            От 8.0
                        </option>
                    }


                    @if (currentMinRating == 8.5m)
                    {
                        <option value="8.5"
                                selected>
                            От 8.5
                        </option>
                    }
                    else
                    {
                        <option value="8.5">
                            От 8.5
                        </option>
                    }


                    @if (currentMinRating == 9m)
                    {
                        <option value="9"
                                selected>
                            От 9.0
                        </option>
                    }
                    else
                    {
                        <option value="9">
                            От 9.0
                        </option>
                    }

                </select>

            </div>



            <!-- SORT -->

            <div class="aw-catalog-filter-field">

                <label for="catalogSort">
                    Сортировка
                </label>


                <select id="catalogSort"
                        name="sort">

                    @if (currentSort == "rating")
                    {
                        <option value="rating"
                                selected>
                            Высокий рейтинг
                        </option>
                    }
                    else
                    {
                        <option value="rating">
                            Высокий рейтинг
                        </option>
                    }


                    @if (currentSort == "rating-low")
                    {
                        <option value="rating-low"
                                selected>
                            Низкий рейтинг
                        </option>
                    }
                    else
                    {
                        <option value="rating-low">
                            Низкий рейтинг
                        </option>
                    }


                    @if (currentSort == "new")
                    {
                        <option value="new"
                                selected>
                            Сначала новые
                        </option>
                    }
                    else
                    {
                        <option value="new">
                            Сначала новые
                        </option>
                    }


                    @if (currentSort == "old")
                    {
                        <option value="old"
                                selected>
                            Сначала старые
                        </option>
                    }
                    else
                    {
                        <option value="old">
                            Сначала старые
                        </option>
                    }


                    @if (currentSort == "title")
                    {
                        <option value="title"
                                selected>
                            По названию
                        </option>
                    }
                    else
                    {
                        <option value="title">
                            По названию
                        </option>
                    }

                </select>

            </div>



            <!-- KEEP PAGE SIZE -->

            <input type="hidden"
                   name="pageSize"
                   value="@pageSize" />



            <!-- APPLY -->

            <button type="submit"
                    class="aw-catalog-filter-submit">

                Применить

            </button>



            <!-- RESET -->
            @if (hasFilters)
            {
                <a asp-controller="Anime"
                   asp-action="Index"
                   asp-route-pageSize="@pageSize"
                   class="aw-catalog-filter-reset">

                    Сбросить

                </a>
            }

        </form>



        <!-- =====================================================
             RESULTS BAR
             ===================================================== -->

        <div class="aw-catalog-pagination-top">

            <div class="aw-catalog-result-count">

                Найдено:

                <strong>
                    @totalItems
                </strong>

                @if (totalItems == 1)
                {
                    <text>аниме</text>
                }
                else
                {
                    <text>аниме</text>
                }

            </div>



            <!-- PAGE SIZE -->

            <form asp-controller="Anime"
                  asp-action="Index"
                  method="get"
                  class="aw-page-size-form"
                  data-no-loading>


                @if (!string.IsNullOrWhiteSpace(currentSearch))
                {
                    <input type="hidden"
                           name="search"
                           value="@currentSearch" />
                }


                @if (currentGenreId.HasValue)
                {
                    <input type="hidden"
                           name="genreId"
                           value="@currentGenreId.Value" />
                }


                @if (currentMinRating.HasValue)
                {
                    <input type="hidden"
                           name="minRating"
                           value="@minRatingRoute" />
                }


                <input type="hidden"
                       name="sort"
                       value="@currentSort" />


                <label for="catalogPageSize">
                    Показывать
                </label>


                <select id="catalogPageSize"
                        name="pageSize"
                        onchange="this.form.submit()">

                    @if (pageSize == 12)
                    {
                        <option value="12"
                                selected>
                            12
                        </option>
                    }
                    else
                    {
                        <option value="12">
                            12
                        </option>
                    }


                    @if (pageSize == 18)
                    {
                        <option value="18"
                                selected>
                            18
                        </option>
                    }
                    else
                    {
                        <option value="18">
                            18
                        </option>
                    }

                </select>

            </form>

        </div>



        <!-- =====================================================
             ACTIVE FILTERS
             ===================================================== -->
        @if (hasFilters)
        {
            <div class="aw-catalog-active-filters">


                @if (!string.IsNullOrWhiteSpace(currentSearch))
                {
                    <span>
                        Поиск:
                        <strong>
                            @currentSearch
                        </strong>
                    </span>
                }


                @if (currentGenreId.HasValue)
                {
                    var selectedGenre =
                        genres.FirstOrDefault(
                            g =>
                                g.Id ==
                                currentGenreId.Value
                        );

                    if (selectedGenre != null)
                    {
                        <span>
                            Жанр:
                            <strong>
                                @selectedGenre.Name
                            </strong>
                        </span>
                    }
                }


                @if (currentMinRating.HasValue)
                {
                    <span>
                        Рейтинг:
                        <strong>
                            от @currentMinRating.Value.ToString("0.0")
                        </strong>
                    </span>
                }

            </div>
        }



        <!-- =====================================================
             ANIME GRID
             ===================================================== -->
        @if (animeList.Any())
        {
            <div class="aw-catalog-grid">

                @foreach (var anime in animeList)
                {
                    <a asp-controller="Anime"
                       asp-action="Details"
                       asp-route-id="@anime.Id"
                       class="aw-anime-card">


                        <!-- POSTER -->

                        <div class="aw-anime-card-poster">

                            @if (!string.IsNullOrWhiteSpace(
                                anime.PosterUrl))
                            {
                                <img src="@anime.PosterUrl"
                                     alt="@anime.Title"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                <div class="aw-anime-card-no-image"
                                     style="display:none;">

                                    A

                                </div>
                            }
                            else
                            {
                                <div class="aw-anime-card-no-image">

                                    A

                                </div>
                            }



                            <!-- RATING -->

                            <span class="aw-anime-card-rating">

                                ★ @anime.Rating.ToString("0.0")

                            </span>



                            <!-- STATUS -->
                            @if (!string.IsNullOrWhiteSpace(
                                                            anime.Status))
                            {
                                <span class="aw-anime-card-status">

                                    @anime.Status

                                </span>
                            }



                            <!-- HOVER -->

                            <div class="aw-anime-card-overlay">

                                <div class="aw-anime-card-play">
                                    ▶
                                </div>

                            </div>

                        </div>



                        <!-- INFO -->

                        <div class="aw-anime-card-info">

                            <h2>
                                @anime.Title
                            </h2>


                            @if (!string.IsNullOrWhiteSpace(
                                anime.OriginalTitle))
                            {
                                <p class="aw-anime-card-original">

                                    @anime.OriginalTitle

                                </p>
                            }


                            <div class="aw-anime-card-meta">

                                <span>
                                    @anime.ReleaseYear
                                </span>


                                @if (!string.IsNullOrWhiteSpace(
                                    anime.AgeRating))
                                {
                                    <i></i>

                                    <span>
                                        @anime.AgeRating
                                    </span>
                                }


                                <i></i>


                                <span>
                                    @anime.EpisodesCount серий
                                </span>

                            </div>



                            <!-- GENRES -->
                            @if (
                                                            anime.AnimeGenres != null
                                                            &&
                                                            anime.AnimeGenres.Any()
                                                        )
                            {
                                <div class="aw-anime-card-genres">

                                    @foreach (
                                        var animeGenre
                                        in anime.AnimeGenres
                                            .Where(
                                                ag =>
                                                    ag.Genre != null
                                            )
                                            .Take(2)
                                    )
                                    {
                                        <span>
                                            @animeGenre.Genre.Name
                                        </span>
                                    }

                                </div>
                            }

                        </div>

                    </a>
                }

            </div>
        }
        else
        {
            <!-- =================================================
                 EMPTY
                 ================================================= -->

            <div class="aw-catalog-empty">

                <div class="aw-catalog-empty-icon">
                    ⌕
                </div>


                <span>
                    NO RESULTS
                </span>


                <h2>
                    Ничего не найдено
                </h2>


                <p>
                    Попробуй изменить запрос,
                    жанр или минимальный рейтинг.
                </p>


                <a asp-controller="Anime"
                   asp-action="Index"
                   asp-route-pageSize="@pageSize">

                    Очистить фильтры

                </a>

            </div>
        }



        <!-- =====================================================
             PAGINATION
             ===================================================== -->
        @if (animeList.Any() && totalPages > 1)
        {
            int startPage =
                Math.Max(
                    1,
                    currentPage - 2
                );


            int endPage =
                Math.Min(
                    totalPages,
                    currentPage + 2
                );


            <nav class="aw-pagination"
                 aria-label="Навигация по страницам каталога">


                <!-- =============================================
                     PREVIOUS
                     ============================================= -->
                @if (currentPage > 1)
                {
                    <a asp-controller="Anime"
                       asp-action="Index"
                       asp-route-search="@currentSearch"
                       asp-route-genreId="@currentGenreId"
                       asp-route-minRating="@minRatingRoute"
                       asp-route-sort="@currentSort"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-pageSize="@pageSize"
                       class="aw-pagination-arrow">

                        ←

                        <span>
                            Назад
                        </span>

                    </a>
                }
                else
                {
                    <span class="aw-pagination-arrow is-disabled">

                        ←

                        <span>
                            Назад
                        </span>

                    </span>
                }



                <!-- =============================================
                     PAGE NUMBERS
                     ============================================= -->

                <div class="aw-pagination-pages">


                    <!-- FIRST PAGE -->
                    @if (startPage > 1)
                    {
                        <a asp-controller="Anime"
                           asp-action="Index"
                           asp-route-search="@currentSearch"
                           asp-route-genreId="@currentGenreId"
                           asp-route-minRating="@minRatingRoute"
                           asp-route-sort="@currentSort"
                           asp-route-page="1"
                           asp-route-pageSize="@pageSize"
                           class="aw-pagination-page">

                            1

                        </a>


                        @if (startPage > 2)
                        {
                            <span class="aw-pagination-dots">

                                •••

                            </span>
                        }
                    }



                    <!-- MIDDLE PAGES -->
                    @for (
                                            int pageNumber = startPage;
                                            pageNumber <= endPage;
                                            pageNumber++
                                        )
                    {
                        if (pageNumber == currentPage)
                        {
                            <span class="aw-pagination-page is-active"
                                  aria-current="page">

                                @pageNumber

                            </span>
                        }
                        else
                        {
                            <a asp-controller="Anime"
                               asp-action="Index"
                               asp-route-search="@currentSearch"
                               asp-route-genreId="@currentGenreId"
                               asp-route-minRating="@minRatingRoute"
                               asp-route-sort="@currentSort"
                               asp-route-page="@pageNumber"
                               asp-route-pageSize="@pageSize"
                               class="aw-pagination-page">

                                @pageNumber

                            </a>
                        }
                    }



                    <!-- LAST PAGE -->
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <span class="aw-pagination-dots">

                                •••

                            </span>
                        }


                        <a asp-controller="Anime"
                           asp-action="Index"
                           asp-route-search="@currentSearch"
                           asp-route-genreId="@currentGenreId"
                           asp-route-minRating="@minRatingRoute"
                           asp-route-sort="@currentSort"
                           asp-route-page="@totalPages"
                           asp-route-pageSize="@pageSize"
                           class="aw-pagination-page">

                            @totalPages

                        </a>
                    }

                </div>



                <!-- =============================================
                     NEXT
                     ============================================= -->
                @if (currentPage < totalPages)
                {
                    <a asp-controller="Anime"
                       asp-action="Index"
                       asp-route-search="@currentSearch"
                       asp-route-genreId="@currentGenreId"
                       asp-route-minRating="@minRatingRoute"
                       asp-route-sort="@currentSort"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-pageSize="@pageSize"
                       class="aw-pagination-arrow">

                        <span>
                            Далее
                        </span>

                        →

                    </a>
                }
                else
                {
                    <span class="aw-pagination-arrow is-disabled">

                        <span>
                            Далее
                        </span>

                        →

                    </span>
                }

            </nav>



            <!-- PAGE INFO -->

            <div class="aw-pagination-info">

                Страница

                <strong>
                    @currentPage
                </strong>

                из

                <strong>
                    @totalPages
                </strong>

            </div>
        }

    </div>

</section>



<!-- =========================================================
     CATALOG BASE STYLES
     Если часть таких стилей уже есть в site.css,
     новые правила просто уточнят внешний вид.
     ========================================================= -->

<style>

    .aw-catalog-page {
        min-height: 100vh;
        padding: 110px 25px 90px;
        background: radial-gradient( circle at 15% 0%, rgba(139,92,246,.08), transparent 25% ), #080a0f;
        color: #fff;
    }


    .aw-catalog-container {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
    }



    /* =====================================================
           HEADER
           ===================================================== */

    .aw-catalog-header {
        margin-bottom: 30px;
    }


    .aw-catalog-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #8b5cf6;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 2.5px;
    }


    .aw-catalog-header h1 {
        margin: 0 0 8px;
        color: #fff;
        font-size: clamp( 42px, 5vw, 64px );
        line-height: 1;
        letter-spacing: -2.5px;
    }


        .aw-catalog-header h1 strong {
            color: #a78bfa;
        }


    .aw-catalog-header p {
        margin: 0;
        color: #626a76;
        font-size: 11px;
    }



    /* =====================================================
           FILTERS
           ===================================================== */

    .aw-catalog-filters {
        display: grid;
        grid-template-columns: minmax(230px,1.5fr) repeat(3,minmax(140px,.7fr)) auto auto;
        align-items: end;
        gap: 10px;
        margin-bottom: 22px;
        padding: 17px;
        border: 1px solid rgba(255,255,255,.05);
        border-radius: 15px;
        background: rgba(15,18,25,.78);
    }


    .aw-catalog-search {
        position: relative;
    }


    .aw-catalog-search-icon {
        position: absolute;
        z-index: 2;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #70627f;
        font-size: 16px;
    }


    .aw-catalog-search input {
        width: 100%;
        height: 43px;
        padding: 0 14px 0 40px;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,.06);
        outline: none;
        border-radius: 9px;
        background: rgba(255,255,255,.025);
        color: #fff;
        font-family: inherit;
        font-size: 9px;
    }


        .aw-catalog-search input:focus {
            border-color: rgba(139,92,246,.4);
        }


    .aw-catalog-filter-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }


        .aw-catalog-filter-field label {
            color: #59616d;
            font-size: 7px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
        }


        .aw-catalog-filter-field select {
            height: 43px;
            padding: 0 12px;
            border: 1px solid rgba(255,255,255,.06);
            outline: none;
            border-radius: 9px;
            background: #10131a;
            color: #aeb4bd;
            font-family: inherit;
            font-size: 8px;
            cursor: pointer;
        }


            .aw-catalog-filter-field select:focus {
                border-color: rgba(139,92,246,.4);
            }


    .aw-catalog-filter-submit {
        height: 43px;
        padding: 0 16px;
        border: none;
        border-radius: 9px;
        background: linear-gradient( 135deg, #9b5cf6, #7c3aed );
        color: #fff;
        font-family: inherit;
        font-size: 8px;
        font-weight: 800;
        cursor: pointer;
    }


    .aw-catalog-filter-reset {
        height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 13px;
        box-sizing: border-box;
        border: 1px solid rgba(255,255,255,.05);
        border-radius: 9px;
        color: #717986;
        font-size: 8px;
        text-decoration: none;
    }


        .aw-catalog-filter-reset:hover {
            color: #fff;
        }



    /* =====================================================
           ACTIVE FILTERS
           ===================================================== */

    .aw-catalog-active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: -7px 0 20px;
    }


        .aw-catalog-active-filters > span {
            padding: 6px 9px;
            border: 1px solid rgba(139,92,246,.10);
            border-radius: 999px;
            background: rgba(139,92,246,.04);
            color: #646d79;
            font-size: 7px;
        }


        .aw-catalog-active-filters strong {
            color: #a78bfa;
        }



    /* =====================================================
           GRID
           ===================================================== */

    .aw-catalog-grid {
        display: grid;
        grid-template-columns: repeat( 6, minmax(0,1fr) );
        gap: 24px 15px;
    }



    /* =====================================================
           CARD
           ===================================================== */

    .aw-anime-card {
        min-width: 0;
        color: inherit;
        text-decoration: none;
        transition: transform .3s cubic-bezier(.22,1,.36,1);
    }


        .aw-anime-card:hover {
            transform: translateY(-6px);
        }


    .aw-anime-card-poster {
        position: relative;
        width: 100%;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        border-radius: 11px;
        background: #11141b;
        box-shadow: 0 10px 30px rgba(0,0,0,.14);
    }


        .aw-anime-card-poster img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .5s ease, filter .3s ease;
        }


    .aw-anime-card:hover
    .aw-anime-card-poster img {
        transform: scale(1.06);
        filter: brightness(.70);
    }


    .aw-anime-card-no-image {
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 135deg, rgba(139,92,246,.08), rgba(255,255,255,.015) );
        color: #5c4b77;
        font-size: 30px;
        font-weight: 900;
    }



    /* RATING */

    .aw-anime-card-rating {
        position: absolute;
        z-index: 5;
        top: 8px;
        right: 8px;
        padding: 5px 7px;
        border-radius: 6px;
        background: rgba(7,9,14,.84);
        color: #fbbf24;
