@model IEnumerable<AnimeWave.Models.Anime>

@using AnimeWave.Models
@using AnimeWave.ViewModels

@{
    ViewData["Title"] = "Главная";


    // =========================================================
    // POPULAR ANIME
    // =========================================================

    var popularAnime =
        Model?.ToList()
        ?? new List<Anime>();



    // =========================================================
    // HERO ANIME
    // =========================================================

    var heroAnime =
        ViewBag.HeroAnime as IEnumerable<Anime>
        ?? Enumerable.Empty<Anime>();


    var heroList =
        heroAnime.ToList();



    // =========================================================
    // POPULARITY
    // =========================================================

    var popularity =
        ViewBag.Popularity
            as Dictionary<int, AnimePopularityViewModel>
        ?? new Dictionary<int, AnimePopularityViewModel>();
}


<div class="aw-home-new">


    @* =========================================================
       CINEMATIC HERO
       ========================================================= *@

    @if (heroList.Any())
    {
        <section class="aw-cinema"
                 id="awCinema">


            @* =================================================
               SLIDES
               ================================================= *@

            <div class="aw-cinema-slides">

                @for (int index = 0;
                    index < heroList.Count;
                    index++)
                {
                    var anime =
                        heroList[index];


                    AnimePopularityViewModel? animePopularity =
                        popularity.TryGetValue(
                            anime.Id,
                            out var popularityValue
                        )
                            ? popularityValue
                            : null;


                    var genres =
                        anime.AnimeGenres?
                            .Where(
                                ag => ag.Genre != null
                            )
                            .Take(4)
                            .ToList()
                        ?? new List<AnimeGenre>();



                    <article class="aw-cinema-slide @(index == 0 ? "is-active" : "")"
                             data-aw-slide="@index">


                        @* =====================================
                           BACKGROUND
                           ===================================== *@

                        <div class="aw-cinema-bg">

                            @if (!string.IsNullOrWhiteSpace(
                                anime.BannerUrl))
                            {
                                <img src="@anime.BannerUrl"
                                     alt=""
                                     aria-hidden="true" />
                            }
                            else if (!string.IsNullOrWhiteSpace(
                                anime.PosterUrl))
                            {
                                <img src="@anime.PosterUrl"
                                     alt=""
                                     aria-hidden="true"
                                     class="is-poster-background" />
                            }

                        </div>


                        <div class="aw-cinema-overlay">
                        </div>



                        @* =====================================
                           CONTENT
                           ===================================== *@

                        <div class="aw-cinema-inner">

                            <div class="aw-cinema-content">


                                @* KICKER *@

                                <div class="aw-cinema-kicker">

                                    <i>
                                    </i>

                                    ANIMEWAVE ORIGINAL

                                </div>



                                @* =================================
                                   HOT / TRENDING / TOP
                                   ================================= *@

                                @if (
                                    animePopularity != null
                                    &&
                                    animePopularity.PopularityScore > 0
                                )
                                {
                                    <div class="aw-cinema-badges">

                                        @if (animePopularity.IsHot)
                                        {
                                            <span class="aw-cinema-hot">

                                                <i>
                                                    ●
                                                </i>

                                                HOT

                                            </span>
                                        }


                                        @if (animePopularity.IsTrending)
                                        {
                                            <span class="aw-cinema-trending">

                                                ↗ TRENDING

                                            </span>
                                        }


                                        @if (animePopularity.IsTop10)
                                        {
                                            <span class="aw-cinema-top">

                                                TOP @animePopularity.Rank

                                            </span>
                                        }

                                    </div>
                                }



                                @* =================================
                                   TITLE
                                   ================================= *@

                                <h1>

                                    @anime.Title

                                </h1>



                                @if (!string.IsNullOrWhiteSpace(
                                    anime.OriginalTitle))
                                {
                                    <p class="aw-cinema-original">

                                        @anime.OriginalTitle

                                    </p>
                                }



                                @* =================================
                                   META
                                   ================================= *@

                                <div class="aw-cinema-meta">

                                    <strong>

                                        ★
                                        @anime.Rating.ToString("0.0")

                                    </strong>


                                    <i>
                                    </i>


                                    <span>

                                        @anime.ReleaseYear

                                    </span>



                                    @if (!string.IsNullOrWhiteSpace(
                                        anime.AgeRating))
                                    {
                                        <i>
                                        </i>


                                        <span class="aw-cinema-age">

                                            @anime.AgeRating

                                        </span>
                                    }



                                    @if (anime.EpisodesCount > 0)
                                    {
                                        <i>
                                        </i>


                                        <span>

                                            @anime.EpisodesCount серий

                                        </span>
                                    }

                                </div>



                                @* =================================
                                   GENRES
                                   ================================= *@

                                @if (genres.Any())
                                {
                                    <div class="aw-cinema-genres">

                                        @foreach (
                                            var animeGenre
                                            in genres
                                        )
                                        {
                                            <a asp-controller="Anime"
                                               asp-action="Index"
                                               asp-route-genreId="@animeGenre.GenreId">

                                                @animeGenre.Genre.Name

                                            </a>
                                        }

                                    </div>
                                }



                                @* =================================
                                   DESCRIPTION
                                   ================================= *@

                                <p class="aw-cinema-description">

                                    @(string.IsNullOrWhiteSpace(
                                        anime.Description
                                    )
                                        ? "Открой новую историю вместе с AnimeWave."
                                        : anime.Description)

                                </p>



                                @* =================================
                                   STATS
                                   ================================= *@

                                @if (animePopularity != null)
                                {
                                    <div class="aw-cinema-stats">

                                        <span>

                                            ◉
                                            @animePopularity.OpenCount

                                            <small>
                                                открытий
                                            </small>

                                        </span>


                                        <span>

                                            ♥
                                            @animePopularity.FavoritesCount

                                            <small>
                                                в избранном
                                            </small>

                                        </span>


                                        <span>

                                            ▶
                                            @animePopularity.UniqueViewersCount

                                            <small>
                                                зрителей
                                            </small>

                                        </span>

                                    </div>
                                }



                                @* =================================
                                   ACTIONS
                                   ================================= *@

                                <div class="aw-cinema-actions">

                                    <a asp-controller="Anime"
                                       asp-action="Details"
                                       asp-route-id="@anime.Id"
                                       class="aw-cinema-primary">

                                        <span>
                                            ▶
                                        </span>

                                        Смотреть

                                    </a>


                                    <a asp-controller="Anime"
                                       asp-action="Details"
                                       asp-route-id="@anime.Id"
                                       class="aw-cinema-secondary">

                                        Подробнее

                                    </a>

                                </div>

                            </div>

                        </div>

                    </article>
                }

            </div>



            @* =================================================
               ARROWS
               ================================================= *@

            @if (heroList.Count > 1)
            {
                <button type="button"
                        class="aw-cinema-arrow aw-cinema-prev"
                        id="awCinemaPrev"
                        aria-label="Предыдущий слайд">

                    ‹

                </button>


                <button type="button"
                        class="aw-cinema-arrow aw-cinema-next"
                        id="awCinemaNext"
                        aria-label="Следующий слайд">

                    ›

                </button>
            }



            @* =================================================
               BOTTOM NAV
               ================================================= *@

            <div class="aw-cinema-bottom">


                @* PROGRESS *@

                <div class="aw-cinema-progress">

                    <div id="awCinemaProgress">
                    </div>

                </div>



                @* THUMBS *@

                <div class="aw-cinema-thumbs">

                    @for (int index = 0;
                        index < heroList.Count;
                        index++)
                    {
                        var anime =
                            heroList[index];


                        <button type="button"
                                class="aw-cinema-thumb @(index == 0 ? "is-active" : "")"
                                data-aw-thumb="@index">


                            <span class="aw-cinema-thumb-index">

                                @($"{index + 1:00}")

                            </span>


                            <span class="aw-cinema-thumb-info">

                                <strong>

                                    @anime.Title

                                </strong>


                                <small>

                                    @anime.ReleaseYear
                                    ·
                                    ★ @anime.Rating.ToString("0.0")

                                </small>

                            </span>

                        </button>
                    }

                </div>

            </div>

        </section>
    }



    @* =========================================================
       POPULAR SECTION
       ========================================================= *@

    <section class="aw-new-popular">


        @* =====================================================
           HEADER
           ===================================================== *@

        <div class="aw-new-popular-header">

            <div>

                <span>

                    TRENDING NOW

                </span>


                <h2>

                    Популярное
                    <strong>
                        сейчас
                    </strong>

                </h2>


                <p>

                    Тайтлы, которые привлекают больше всего
                    внимания пользователей AnimeWave.

                </p>

            </div>


            <a asp-controller="Anime"
               asp-action="Index">

                Смотреть всё

                <span>
                    →
                </span>

            </a>

        </div>



        @* =====================================================
           GRID
           ===================================================== *@

        @if (popularAnime.Any())
        {
            <div class="aw-new-grid">

                @foreach (var anime in popularAnime)
                {
                    AnimePopularityViewModel? animePopularity =
                        popularity.TryGetValue(
                            anime.Id,
                            out var cardPopularity
                        )
                            ? cardPopularity
                            : null;


                    var genres =
                        anime.AnimeGenres?
                            .Where(
                                ag => ag.Genre != null
                            )
                            .Take(2)
                            .ToList()
                        ?? new List<AnimeGenre>();



                    <article class="aw-new-card">


                        @* =====================================
                           POSTER
                           ===================================== *@

                        <a asp-controller="Anime"
                           asp-action="Details"
                           asp-route-id="@anime.Id"
                           class="aw-new-card-poster">


                            @* POPULARITY BADGES *@

                            @if (
                                animePopularity != null
                                &&
                                animePopularity.PopularityScore > 0
                            )
                            {
                                <div class="aw-new-card-badges">

                                    @if (animePopularity.IsHot)
                                    {
                                        <span class="is-hot">

                                            HOT

                                        </span>
                                    }


                                    @if (animePopularity.IsTrending)
                                    {
                                        <span class="is-trending">

                                            TRENDING

                                        </span>
                                    }


                                    @if (animePopularity.IsTop10)
                                    {
                                        <span class="is-top">

                                            TOP @animePopularity.Rank

                                        </span>
                                    }

                                </div>
                            }



                            @* IMAGE *@

                            @if (!string.IsNullOrWhiteSpace(
                                anime.PosterUrl))
                            {
                                <img src="@anime.PosterUrl"
                                     alt="@anime.Title"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />


                                <div class="aw-new-card-placeholder"
                                     style="display:none;">

                                    AW

                                </div>
                            }
                            else
                            {
                                <div class="aw-new-card-placeholder">

                                    AW

                                </div>
                            }



                            @* RATING *@

                            <span class="aw-new-card-rating">

                                ★
                                @anime.Rating.ToString("0.0")

                            </span>



                            @* SHADOW *@

                            <div class="aw-new-card-shadow">
                            </div>



                            @* HOVER *@

                            <div class="aw-new-card-hover">

                                <span>
                                    ▶
                                </span>


                                <strong>
                                    Подробнее
                                </strong>

                            </div>

                        </a>



                        @* =====================================
                           INFO
                           ===================================== *@

                        <div class="aw-new-card-info">

                            <a asp-controller="Anime"
                               asp-action="Details"
                               asp-route-id="@anime.Id"
                               class="aw-new-card-title">

                                @anime.Title

                            </a>


                            <div class="aw-new-card-meta">

                                <span>

                                    @anime.ReleaseYear

                                </span>


                                @if (anime.EpisodesCount > 0)
                                {
                                    <i>
                                    </i>


                                    <span>

                                        @anime.EpisodesCount серий

                                    </span>
                                }

                            </div>



                            @if (genres.Any())
                            {
                                <div class="aw-new-card-genres">

                                    @foreach (
                                        var animeGenre
                                        in genres
                                    )
                                    {
                                        <span>

                                            @animeGenre.Genre.Name

                                        </span>
                                    }

                                </div>
                            }



                            @if (
                                animePopularity != null
                                &&
                                animePopularity.PopularityScore > 0
                            )
                            {
                                <div class="aw-new-card-stats">

                                    <span title="Открытия">

                                        ◉
                                        @animePopularity.OpenCount

                                    </span>


                                    <span title="В избранном">

                                        ♥
                                        @animePopularity.FavoritesCount

                                    </span>


                                    <span title="Зрители">

                                        ▶
                                        @animePopularity.UniqueViewersCount

                                    </span>

                                </div>
                            }

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="aw-new-empty">

                <span>
                    ◇
                </span>


                <strong>
                    Каталог пока пуст
                </strong>


                <p>
                    Добавь аниме через панель администратора.
                </p>

            </div>
        }

    </section>



    @* =========================================================
       DISCOVER CTA
       ========================================================= *@

    <section class="aw-new-discover">

        <div>

            <span>
                DISCOVER
            </span>


            <h2>

                Найди свою
                <strong>
                    следующую историю
                </strong>

            </h2>


            <p>

                Исследуй весь каталог, сохраняй любимые
                тайтлы и находи новые истории в AnimeWave.

            </p>

        </div>


        <a asp-controller="Anime"
           asp-action="Index">

            Открыть каталог

            <span>
                →
            </span>

        </a>

    </section>

</div>



<style>

    /* =========================================================
           HOME
           ========================================================= */

    .aw-home-new,
    .aw-home-new * {
        box-sizing: border-box;
    }


    .aw-home-new {
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        background: #080a0f;
        color: #fff;
    }


        .aw-home-new a {
            text-decoration: none;
        }



    /* =========================================================
           CINEMATIC HERO
           ========================================================= */

    .aw-cinema {
        position: relative;
        width: 100%;
        height: 650px;
        overflow: hidden;
        border-bottom: 1px solid rgba(255,255,255,.04);
        background: #080a0f;
    }


    .aw-cinema-slides {
        position: absolute;
        inset: 0;
    }



    /* =========================================================
           SLIDE
           ========================================================= */

    .aw-cinema-slide {
        position: absolute;
        inset: 0;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: opacity .75s ease, visibility .75s ease;
    }


        .aw-cinema-slide.is-active {
            z-index: 3;
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
        }



    /* =========================================================
           BACKGROUND
           ========================================================= */

    .aw-cinema-bg {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }


        .aw-cinema-bg img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            object-position: center 30%;
            filter: brightness(.48) saturate(.88);
            transform: scale(1.02);
            transition: transform 7s ease;
        }


            .aw-cinema-bg img.is-poster-background {
                object-position: center 20%;
            }


    .aw-cinema-slide.is-active
    .aw-cinema-bg img {
        transform: scale(1.07);
    }


    .aw-cinema-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 90deg, #080a0f 0%, rgba(8,10,15,.95) 20%, rgba(8,10,15,.72) 46%, rgba(8,10,15,.17) 76%, rgba(8,10,15,.35) 100% ), linear-gradient( 180deg, rgba(8,10,15,.10) 0%, transparent 50%, #080a0f 100% );
    }



    /* =========================================================
           INNER
           ========================================================= */

    .aw-cinema-inner {
        position: relative;
        z-index: 5;
        width: min( 1380px, calc(100% - 64px) );
        height: 100%;
        display: flex;
        align-items: center;
        margin: 0 auto;
        padding: 72px 0 105px;
    }


    .aw-cinema-content {
        width: min( 640px, 100% );
    }



    /* =========================================================
           KICKER
           ========================================================= */

    .aw-cinema-kicker {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 9px;
        color: var(--aw-accent-soft,#a78bfa);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 2px;
    }


        .aw-cinema-kicker > i {
            width: 18px;
            height: 1px;
            display: block;
            background: var(--aw-accent,#8b5cf6);
        }



    /* =========================================================
           BADGES
           ========================================================= */

    .aw-cinema-badges {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 10px;
    }


        .aw-cinema-badges > span {
            min-height: 23px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 0 8px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 6px;
            font-size: 8px;
            font-weight: 900;
            letter-spacing: .4px;
            backdrop-filter: blur(10px);
        }


    .aw-cinema-hot {
        border-color: rgba(239,68,68,.27) !important;
        background: rgba(239,68,68,.11);
        color: #fb7185;
    }


        .aw-cinema-hot > i {
            font-size: 6px;
            font-style: normal;
        }


    .aw-cinema-trending {
        border-color: rgba( var(--aw-accent-rgb,139,92,246), .24 ) !important;
        background: rgba( var(--aw-accent-rgb,139,92,246), .08 );
        color: var(--aw-accent-soft,#a78bfa);
    }


    .aw-cinema-top {
        border-color: rgba(245,158,11,.25) !important;
        background: rgba(245,158,11,.09);
        color: #fbbf24;
    }



    /* =========================================================
           TITLE
           ========================================================= */

    .aw-cinema-content h1 {
        max-width: 680px;
        margin: 0 0 5px;
        color: #fff;
        font-size: clamp( 42px, 4.25vw, 64px );
        font-weight: 950;
        line-height: .98;
        letter-spacing: -2.3px;
        text-wrap: balance;
    }


    .aw-cinema-original {
        margin: 0 0 11px;
        color: rgba(255,255,255,.48);
        font-size: 13px;
        font-weight: 500;
    }



    /* =========================================================
           META
           ========================================================= */

    .aw-cinema-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 11px;
        color: rgba(235,238,243,.76);
        font-size: 12px;
        font-weight: 700;
    }


        .aw-cinema-meta > strong {
            color: #fbbf24;
        }


        .aw-cinema-meta > i {
            width: 3px;
            height: 3px;
            display: block;
            border-radius: 50%;
            background: rgba(255,255,255,.24);
        }


    .aw-cinema-age {
        padding: 3px 6px;
        border: 1px solid rgba(255,255,255,.17);
        border-radius: 4px;
    }



    /* =========================================================
           GENRES
           ========================================================= */

    .aw-cinema-genres {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        margin-bottom: 12px;
    }


        .aw-cinema-genres a {
            padding: 5px 8px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 6px;
            background: rgba(255,255,255,.045);
            color: rgba(255,255,255,.80) !important;
            font-size: 9px;
            font-weight: 700;
            backdrop-filter: blur(10px);
            transition: border-color .2s ease, background .2s ease, color .2s ease;
        }


            .aw-cinema-genres a:hover {
                border-color: rgba( var(--aw-accent-rgb,139,92,246), .27 );
                background: rgba( var(--aw-accent-rgb,139,92,246), .10 );
                color: #fff !important;
            }



    /* =========================================================
           DESCRIPTION
           ========================================================= */

    .aw-cinema-description {
        max-width: 590px;
        display: -webkit-box;
        margin: 0 0 13px;
        overflow: hidden;
        color: rgba(229,232,238,.72);
        font-size: 13px;
        line-height: 1.65;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }



    /* =========================================================
           STATS
           ========================================================= */

    .aw-cinema-stats {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 17px;
    }


        .aw-cinema-stats > span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            min-height: 29px;
            padding: 0 8px;
            border: 1px solid rgba(255,255,255,.05);
            border-radius: 7px;
            background: rgba(7,9,14,.42);
            color: rgba(255,255,255,.72);
            font-size: 9px;
            font-weight: 800;
            backdrop-filter: blur(10px);
        }


        .aw-cinema-stats small {
            color: rgba(255,255,255,.44);
            font-size: 8px;
            font-weight: 600;
        }



    /* =========================================================
           ACTIONS
           ========================================================= */

    .aw-cinema-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }


    .aw-cinema-primary,
    .aw-cinema-secondary {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 0 15px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 800;
        transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }


    .aw-cinema-primary {
        background: linear-gradient( 135deg, var(--aw-accent,#8b5cf6), var(--aw-accent-strong,#7c3aed) );
        color: #fff !important;
        box-shadow: 0 12px 30px rgba( var(--aw-accent-rgb,139,92,246), .20 );
    }


    .aw-cinema-secondary {
        border: 1px solid rgba(255,255,255,.09);
        background: rgba(255,255,255,.055);
        color: #fff !important;
        backdrop-filter: blur(10px);
    }


        .aw-cinema-primary:hover,
        .aw-cinema-secondary:hover {
            transform: translateY(-2px);
        }



    /* =========================================================
           ARROWS
           ========================================================= */

    .aw-cinema-arrow {
        position: absolute;
        z-index: 30;
        top: 46%;
        width: 38px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transform: translateY(-50%);
        border: 1px solid rgba(255,255,255,.07);
        border-radius: 9px;
        background: rgba(7,9,14,.46);
