</style>



@section Scripts
{
    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function() {

                const hero =
                    document.getElementById(
                        "awCinema"
                    );


                if (!hero) {
                    return;
                }



                const slides =
                    Array.from(
                        hero.querySelectorAll(
                            "[data-aw-slide]"
                        )
                    );


                const thumbs =
                    Array.from(
                        hero.querySelectorAll(
                            "[data-aw-thumb]"
                        )
                    );


                const previousButton =
                    document.getElementById(
                        "awCinemaPrev"
                    );


                const nextButton =
                    document.getElementById(
                        "awCinemaNext"
                    );


                const progressBar =
                    document.getElementById(
                        "awCinemaProgress"
                    );


                if (slides.length === 0) {
                    return;
                }



                let currentIndex =
                    0;


                let autoplayTimer =
                    null;


                let progressTimer =
                    null;


                const slideDuration =
                    6500;


                const progressInterval =
                    50;



                // =================================================
                // SHOW SLIDE
                // =================================================

                function showSlide(index) {

                    if (index < 0) {
                        index =
                            slides.length - 1;
                    }


                    if (index >= slides.length) {
                        index =
                            0;
                    }


                    currentIndex =
                        index;


                    slides.forEach(
                        function(
                            slide,
                            slideIndex
                        ) {

                            slide.classList.toggle(
                                "is-active",
                                slideIndex
                                ===
                                currentIndex
                            );

                        }
                    );


                    thumbs.forEach(
                        function(
                            thumb,
                            thumbIndex
                        ) {

                            thumb.classList.toggle(
                                "is-active",
                                thumbIndex
                                ===
                                currentIndex
                            );

                        }
                    );


                    restartProgress();

                }



                // =================================================
                // PROGRESS
                // =================================================

                function stopProgress() {

                    if (progressTimer) {

                        clearInterval(
                            progressTimer
                        );


                        progressTimer =
                            null;
                    }

                }



                function restartProgress() {

                    stopProgress();


                    if (!progressBar) {
                        return;
                    }


                    let elapsed =
                        0;


                    progressBar.style.width =
                        "0%";


                    progressTimer =
                        setInterval(
                            function() {

                                elapsed +=
                                    progressInterval;


                                const percentage =
                                    Math.min(
                                        (
                                            elapsed
                                            /
                                            slideDuration
                                        )
                                        *
                                        100,
                                        100
                                    );


                                progressBar.style.width =
                                    percentage
                                    +
                                    "%";


                                if (
                                    percentage
                                    >=
                                    100
                                ) {
                                    stopProgress();
                                }

                            },
                            progressInterval
                        );

                }



                // =================================================
                // AUTOPLAY
                // =================================================

                function stopAutoplay() {

                    if (autoplayTimer) {

                        clearInterval(
                            autoplayTimer
                        );


                        autoplayTimer =
                            null;
                    }

                }



                function startAutoplay() {

                    stopAutoplay();


                    if (slides.length <= 1) {
                        return;
                    }


                    autoplayTimer =
                        setInterval(
                            function() {

                                showSlide(
                                    currentIndex + 1
                                );

                            },
                            slideDuration
                        );

                }



                function restartAutoplay() {

                    startAutoplay();

                }



                // =================================================
                // PREVIOUS
                // =================================================

                if (previousButton) {

                    previousButton.addEventListener(
                        "click",
                        function() {

                            showSlide(
                                currentIndex - 1
                            );


                            restartAutoplay();

                        }
                    );

                }



                // =================================================
                // NEXT
                // =================================================

                if (nextButton) {

                    nextButton.addEventListener(
                        "click",
                        function() {

                            showSlide(
                                currentIndex + 1
                            );


                            restartAutoplay();

                        }
                    );

                }



                // =================================================
                // THUMBS
                // =================================================

                thumbs.forEach(
                    function(
                        thumb,
                        index
                    ) {

                        thumb.addEventListener(
                            "click",
                            function() {

                                showSlide(
                                    index
                                );


                                restartAutoplay();

                            }
                        );

                    }
                );



                // =================================================
                // KEYBOARD
                // =================================================

                document.addEventListener(
                    "keydown",
                    function(event) {

                        if (
                            event.key
                            ===
                            "ArrowLeft"
                        ) {
                            showSlide(
                                currentIndex - 1
                            );


                            restartAutoplay();
                        }


                        if (
                            event.key
                            ===
                            "ArrowRight"
                        ) {
                            showSlide(
                                currentIndex + 1
                            );


                            restartAutoplay();
                        }

                    }
                );



                // =================================================
                // PAUSE
                // =================================================

                hero.addEventListener(
                    "mouseenter",
                    function() {

                        stopAutoplay();
                        stopProgress();

                    }
                );


                hero.addEventListener(
                    "mouseleave",
                    function() {

                        restartProgress();
                        startAutoplay();

                    }
                );



                // =================================================
                // TAB VISIBILITY
                // =================================================

                document.addEventListener(
                    "visibilitychange",
                    function() {

                        if (document.hidden) {

                            stopAutoplay();
                            stopProgress();

                        }
                        else {

                            restartProgress();
                            startAutoplay();

                        }

                    }
                );



                // =================================================
                // START
                // =================================================

                showSlide(0);

                startAutoplay();

            }
        );

    </script>
}