<!-- =========================================================
     CAROUSEL JAVASCRIPT
     ========================================================= -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const carousel =
                document.getElementById(
                    "homeHeroCarousel"
                );


            if (!carousel) {
                return;
            }


            const slides =
                Array.from(
                    carousel.querySelectorAll(
                        ".aw-home-hero-slide"
                    )
                );


            const dots =
                Array.from(
                    carousel.querySelectorAll(
                        ".aw-home-dot"
                    )
                );


            const prevButton =
                document.getElementById(
                    "homeHeroPrev"
                );


            const nextButton =
                document.getElementById(
                    "homeHeroNext"
                );


            const counter =
                document.getElementById(
                    "homeHeroCurrent"
                );


            const progress =
                document.getElementById(
                    "homeHeroProgress"
                );


            if (slides.length <= 1) {

                if (progress) {
                    progress.style.width = "100%";
                }

                return;
            }


            let currentIndex = 0;

            let timer = null;

            let progressAnimation = null;

            let paused = false;


            const delay = 6000;



            // =================================================
            // PROGRESS
            // =================================================

            function restartProgress() {

                if (!progress) {
                    return;
                }


                if (progressAnimation) {
                    progressAnimation.cancel();
                }


                progress.style.width =
                    "0%";


                progressAnimation =
                    progress.animate(
                        [
                            {
                                width: "0%"
                            },
                            {
                                width: "100%"
                            }
                        ],
                        {
                            duration: delay,
                            easing: "linear",
                            fill: "forwards"
                        }
                    );


                if (paused) {
                    progressAnimation.pause();
                }

            }



            // =================================================
            // SHOW SLIDE
            // =================================================

            function showSlide(index) {

                if (index < 0) {
                    index =
                        slides.length - 1;
                }


                if (index >= slides.length) {
                    index = 0;
                }


                slides[currentIndex]
                    .classList.remove(
                        "active"
                    );


                if (dots[currentIndex]) {

                    dots[currentIndex]
                        .classList.remove(
                            "active"
                        );

                }


                currentIndex = index;


                slides[currentIndex]
                    .classList.add(
                        "active"
                    );


                if (dots[currentIndex]) {

                    dots[currentIndex]
                        .classList.add(
                            "active"
                        );

                }


                if (counter) {

                    counter.textContent =
                        String(
                            currentIndex + 1
                        )
                            .padStart(
                                2,
                                "0"
                            );

                }


                restartProgress();

            }



            // =================================================
            // NEXT
            // =================================================

            function nextSlide() {

                showSlide(
                    currentIndex + 1
                );

            }



            // =================================================
            // PREVIOUS
            // =================================================

            function previousSlide() {

                showSlide(
                    currentIndex - 1
                );

            }



            // =================================================
            // TIMER
            // =================================================

            function startTimer() {

                if (timer) {

                    clearInterval(
                        timer
                    );

                }


                timer =
                    setInterval(
                        function() {

                            if (!paused) {

                                nextSlide();

                            }

                        },
                        delay
                    );

            }



            // =================================================
            // NEXT BUTTON
            // =================================================

            if (nextButton) {

                nextButton.addEventListener(
                    "click",
                    function() {

                        nextSlide();

                        startTimer();

                    }
                );

            }



            // =================================================
            // PREVIOUS BUTTON
            // =================================================

            if (prevButton) {

                prevButton.addEventListener(
                    "click",
                    function() {

                        previousSlide();

                        startTimer();

                    }
                );

            }



            // =================================================
            // DOTS
            // =================================================

            dots.forEach(
                function(dot, index) {

                    dot.addEventListener(
                        "click",
                        function() {

                            showSlide(
                                index
                            );

                            startTimer();

                        }
                    );

                }
            );



            // =================================================
            // PAUSE ON HOVER
            // =================================================

            carousel.addEventListener(
                "mouseenter",
                function() {

                    paused = true;


                    if (progressAnimation) {

                        progressAnimation.pause();

                    }

                }
            );


            carousel.addEventListener(
                "mouseleave",
                function() {

                    paused = false;


                    if (progressAnimation) {

                        progressAnimation.play();

                    }

                }
            );



            // =================================================
            // KEYBOARD
            // =================================================

            document.addEventListener(
                "keydown",
                function(event) {

                    if (
                        event.key ===
                        "ArrowRight"
                    ) {

                        nextSlide();

                        startTimer();

                    }


                    if (
                        event.key ===
                        "ArrowLeft"
                    ) {

                        previousSlide();

                        startTimer();

                    }

                }
            );



            // =================================================
            // SWIPE
            // =================================================

            let touchStartX = 0;


            carousel.addEventListener(
                "touchstart",
                function(event) {

                    touchStartX =
                        event.changedTouches[0]
                            .screenX;

                },
                {
                    passive: true
                }
            );


            carousel.addEventListener(
                "touchend",
                function(event) {

                    const touchEndX =
                        event.changedTouches[0]
                            .screenX;


                    const distance =
                        touchEndX -
                        touchStartX;


                    if (
                        Math.abs(distance) <
                        50
                    ) {
                        return;
                    }


                    if (distance < 0) {

                        nextSlide();

                    }
                    else {

                        previousSlide();

                    }


                    startTimer();

                },
                {
                    passive: true
                }
            );



            // =================================================
            // START
            // =================================================

            restartProgress();

            startTimer();

        }
    );

</script>