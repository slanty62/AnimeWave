@model IEnumerable<AnimeWave.Models.Anime>

@{
    ViewData["Title"] = "Главная";

    var allAnime =
        Model?.ToList()
        ?? new List<AnimeWave.Models.Anime>();

    // Аниме для верхней карусели.
    // Берём только те, у которых есть BannerUrl.
    var heroAnime = allAnime
        .Where(a => !string.IsNullOrWhiteSpace(a.BannerUrl))
        .OrderByDescending(a => a.Rating)
        .Take(6)
        .ToList();

    // Карточки "Популярное"
    var popularAnime = allAnime
        .OrderByDescending(a => a.Rating)
        .Take(12)
        .ToList();
}


<!-- =========================================================
     HERO CAROUSEL
     ========================================================= -->
@if (heroAnime.Any())
{
    <section class="aw-home-hero"
             id="homeHeroCarousel">

        <div class="aw-home-hero-slides">

            @for (int i = 0; i < heroAnime.Count; i++)
            {
                var anime = heroAnime[i];

                var genres = anime.AnimeGenres
                    .Where(ag => ag.Genre != null)
                    .Select(ag => ag.Genre)
                    .Take(3)
                    .ToList();


                <article class="aw-home-hero-slide @(i == 0 ? "active" : "")"
                         data-slide="@i">


                    <!-- BACKGROUND -->

                    <div class="aw-home-hero-bg">

                        <img src="@anime.BannerUrl"
                             alt="@anime.Title"
                             loading="@(i == 0 ? "eager" : "lazy")" />

                    </div>


                    <!-- DARK OVERLAY -->

                    <div class="aw-home-hero-overlay">
                    </div>


                    <!-- CONTENT -->

                    <div class="aw-home-hero-content">

                        <div class="aw-home-hero-inner">


                            <span class="aw-home-hero-label">
                                ANIMEWAVE ORIGINAL
                            </span>


                            <h1>
                                @anime.Title
                            </h1>


                            @if (!string.IsNullOrWhiteSpace(anime.OriginalTitle))
                            {
                                <div class="aw-home-original-title">
                                    @anime.OriginalTitle
                                </div>
                            }


                            <!-- META -->

                            <div class="aw-home-hero-meta">

                                <span class="aw-home-rating">
                                    ★ @anime.Rating.ToString("0.0")
                                </span>

                                <span>
                                    @anime.ReleaseYear
                                </span>


                                @if (!string.IsNullOrWhiteSpace(anime.AgeRating))
                                {
                                    <span class="aw-home-age">
                                        @anime.AgeRating
                                    </span>
                                }


                                <span>
                                    @anime.EpisodesCount серий
                                </span>

                            </div>


                            <!-- GENRES -->
                            @if (genres.Any())
                            {
                                <div class="aw-home-hero-genres">

                                    @foreach (var genre in genres)
                                    {
                                        <span>
                                            @genre.Name
                                        </span>
                                    }

                                </div>
                            }


                            <!-- DESCRIPTION -->
                            @if (!string.IsNullOrWhiteSpace(anime.Description))
                            {
                                <p class="aw-home-hero-description">
                                    @anime.Description
                                </p>
                            }


                            <!-- BUTTONS -->

                            <div class="aw-home-hero-actions">

                                <a asp-controller="Anime"
                                   asp-action="Details"
                                   asp-route-id="@anime.Id"
                                   class="aw-home-watch">

                                    <span>
                                        ▶
                                    </span>

                                    Смотреть

                                </a>


                                <a asp-controller="Anime"
                                   asp-action="Details"
                                   asp-route-id="@anime.Id"
                                   class="aw-home-more">

                                    Подробнее

                                </a>

                            </div>

                        </div>

                    </div>

                </article>
            }

        </div>


        <!-- =====================================================
             ARROWS
             ===================================================== -->
        @if (heroAnime.Count > 1)
        {
            <button type="button"
                    class="aw-home-arrow aw-home-arrow-left"
                    id="homeHeroPrev"
                    aria-label="Предыдущее аниме">

                ‹

            </button>


            <button type="button"
                    class="aw-home-arrow aw-home-arrow-right"
                    id="homeHeroNext"
                    aria-label="Следующее аниме">

                ›

            </button>
        }


        <!-- =====================================================
             BOTTOM
             ===================================================== -->

        <div class="aw-home-hero-navigation">

            <div class="aw-home-hero-dots">

                @for (int i = 0; i < heroAnime.Count; i++)
                {
                    <button type="button"
                            class="aw-home-dot @(i == 0 ? "active" : "")"
                            data-index="@i"
                            aria-label="Открыть слайд @(i + 1)">
                    </button>
                }

            </div>


            <div class="aw-home-counter">

                <span id="homeHeroCurrent">
                    01
                </span>

                <i></i>

                <span>
                    @heroAnime.Count.ToString("00")
                </span>

            </div>

        </div>


        <!-- PROGRESS -->

        <div class="aw-home-progress">

            <div class="aw-home-progress-value"
                 id="homeHeroProgress">
            </div>

        </div>

    </section>
}
else
{
    <!-- Если баннеров пока нет -->

    <section class="aw-home-no-hero">

        <span>
            ANIMEWAVE
        </span>

        <h1>
            Твой мир аниме
        </h1>

        <p>
            Добавь BannerUrl через админ-панель,
            чтобы здесь появилась карусель.
        </p>

    </section>
}



<!-- =========================================================
     POPULAR
     ========================================================= -->

<section class="aw-home-popular">

    <div class="aw-home-section-head">

        <div>

            <span class="aw-home-section-label">
                TRENDING NOW
            </span>

            <h2>
                Популярное
            </h2>

        </div>


        <a asp-controller="Anime"
           asp-action="Index"
           class="aw-home-see-all">

            Смотреть всё →

        </a>

    </div>


    @if (popularAnime.Any())
    {
        <div class="aw-home-grid">

            @foreach (var anime in popularAnime)
            {
                <a asp-controller="Anime"
                   asp-action="Details"
                   asp-route-id="@anime.Id"
                   class="aw-home-card">


                    <!-- POSTER -->

                    <div class="aw-home-card-poster">

                        @if (!string.IsNullOrWhiteSpace(anime.PosterUrl))
                        {
                            <img src="@anime.PosterUrl"
                                 alt="@anime.Title"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="aw-home-card-empty">
                                ANIMEWAVE
                            </div>
                        }


                        <!-- RATING -->

                        <span class="aw-home-card-rating">

                            ★ @anime.Rating.ToString("0.0")

                        </span>


                        <!-- HOVER -->

                        <div class="aw-home-card-hover">

                            <div class="aw-home-card-play">
                                ▶
                            </div>

                        </div>

                    </div>


                    <!-- INFO -->

                    <div class="aw-home-card-info">

                        <h3>
                            @anime.Title
                        </h3>


                        <div class="aw-home-card-meta">

                            <span>
                                @anime.ReleaseYear
                            </span>

                            <i></i>

                            <span>
                                @anime.EpisodesCount серий
                            </span>

                        </div>

                    </div>

                </a>
            }

        </div>
    }
    else
    {
        <div class="aw-home-empty">

            <h3>
                Пока нет аниме
            </h3>

            <p>
                Добавь несколько тайтлов через админ-панель.
            </p>

        </div>
    }

</section>



<!-- =========================================================
     STYLE
     ========================================================= -->

<style>

    /* =====================================================
           HOME
           ===================================================== */

    .aw-home-hero {
        position: relative;
        width: 100%;
        height: 610px;
        overflow: hidden;
        background: #080a0f;
        isolation: isolate;
    }


    .aw-home-hero-slides {
        position: absolute;
        inset: 0;
    }



    /* =====================================================
           SLIDE
           ===================================================== */

    .aw-home-hero-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: scale(1.025);
        transition: opacity .9s ease, visibility .9s ease, transform 7s ease;
    }


        .aw-home-hero-slide.active {
            z-index: 2;
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: scale(1);
        }



    /* =====================================================
           BACKGROUND
           ===================================================== */

    .aw-home-hero-bg {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }


        .aw-home-hero-bg img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transform: scale(1.06);
            transition: transform 7s cubic-bezier(.2,.8,.2,1);
        }


    .aw-home-hero-slide.active
    .aw-home-hero-bg img {
        transform: scale(1);
    }



    /* =====================================================
           OVERLAY
           ===================================================== */

    .aw-home-hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient( 90deg, rgba(5,7,12,.98) 0%, rgba(5,7,12,.90) 18%, rgba(5,7,12,.66) 37%, rgba(5,7,12,.28) 65%, rgba(5,7,12,.14) 100% ), linear-gradient( 0deg, #080a0f 0%, rgba(8,10,15,.94) 7%, rgba(8,10,15,.24) 42%, rgba(8,10,15,.18) 100% );
    }



    /* =====================================================
           CONTENT
           ===================================================== */

    .aw-home-hero-content {
        position: relative;
        z-index: 5;
        width: 100%;
        height: 100%;
        max-width: 1600px;
        margin: 0 auto;
        box-sizing: border-box;
        padding: 105px clamp(45px, 7vw, 120px) 92px;
        display: flex;
        align-items: center;
    }


    .aw-home-hero-inner {
        width: min(650px, 58vw);
        opacity: 0;
        transform: translateX(-18px) translateY(12px);
        transition: opacity .65s ease .18s, transform .75s cubic-bezier(.22,1,.36,1) .18s;
    }


    .aw-home-hero-slide.active
    .aw-home-hero-inner {
        opacity: 1;
        transform: translateX(0) translateY(0);
    }



    /* =====================================================
           LABEL
           ===================================================== */

    .aw-home-hero-label {
        display: block;
        margin-bottom: 17px;
        color: #a78bfa;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 3px;
    }



    /* =====================================================
           TITLE
           ===================================================== */

    .aw-home-hero-inner h1 {
        max-width: 780px;
        margin: 0 0 11px;
        color: #ffffff;
        font-size: clamp( 48px, 5vw, 78px );
        font-weight: 900;
        line-height: .97;
        letter-spacing: -3.5px;
        text-shadow: 0 12px 45px rgba(0,0,0,.55);
    }


    .aw-home-original-title {
        margin-bottom: 17px;
        color: rgba(255,255,255,.42);
        font-size: 12px;
    }



    /* =====================================================
           META
           ===================================================== */

    .aw-home-hero-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 13px;
        margin-bottom: 17px;
        color: #f4f4f5;
        font-size: 12px;
        font-weight: 700;
    }


    .aw-home-rating {
        color: #fbbf24;
    }


    .aw-home-age {
        padding: 3px 7px;
        border: 1px solid rgba(255,255,255,.30);
        border-radius: 5px;
    }



    /* =====================================================
           GENRES
           ===================================================== */

    .aw-home-hero-genres {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 20px;
    }


        .aw-home-hero-genres span {
            padding: 6px 12px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 999px;
            background: rgba(255,255,255,.075);
            backdrop-filter: blur(12px);
            color: rgba(255,255,255,.88);
            font-size: 10px;
            font-weight: 700;
        }



    /* =====================================================
           DESCRIPTION
           ===================================================== */

    .aw-home-hero-description {
        display: -webkit-box;
        max-width: 610px;
        margin: 0 0 27px;
        overflow: hidden;
        color: rgba(232,235,241,.82);
        font-size: 13px;
        line-height: 1.8;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }



    /* =====================================================
           BUTTONS
           ===================================================== */

    .aw-home-hero-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .aw-home-watch,
    .aw-home-more {
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
    }


    .aw-home-watch {
        gap: 9px;
        color: #ffffff;
        background: linear-gradient( 135deg, #9b5cf6, #7c3aed );
        box-shadow: 0 12px 35px rgba(139,92,246,.25);
    }


        .aw-home-watch:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 17px 40px rgba(139,92,246,.36);
        }


        .aw-home-watch span {
            font-size: 10px;
        }


    .aw-home-more {
        color: #ffffff;
        background: rgba(255,255,255,.105);
        border: 1px solid rgba(255,255,255,.08);
        backdrop-filter: blur(12px);
    }


        .aw-home-more:hover {
            color: #ffffff;
            background: rgba(255,255,255,.17);
            transform: translateY(-2px);
        }



    /* =====================================================
           ARROWS
           ===================================================== */

    .aw-home-arrow {
        position: absolute;
        z-index: 20;
        top: 50%;
        width: 44px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 11px;
        background: rgba(7,9,14,.42);
        backdrop-filter: blur(12px);
        color: rgba(255,255,255,.72);
        font-family: Arial, sans-serif;
        font-size: 32px;
        cursor: pointer;
        opacity: 0;
        transform: translateY(-50%);
        transition: opacity .25s ease, background .25s ease, color .25s ease;
    }


    .aw-home-hero:hover
    .aw-home-arrow {
        opacity: 1;
    }


    .aw-home-arrow:hover {
        color: #ffffff;
        background: rgba(139,92,246,.75);
    }


    .aw-home-arrow-left {
        left: 22px;
    }


    .aw-home-arrow-right {
        right: 22px;
    }



    /* =====================================================
           HERO NAVIGATION
           ===================================================== */

    .aw-home-hero-navigation {
        position: absolute;
        z-index: 20;
        left: clamp(45px, 7vw, 120px);
        right: clamp(45px, 7vw, 120px);
        bottom: 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        pointer-events: none;
    }


    .aw-home-hero-dots {
        display: flex;
        align-items: center;
        gap: 7px;
        pointer-events: auto;
    }


    .aw-home-dot {
        width: 7px;
        height: 7px;
        padding: 0;
        border: none;
        border-radius: 999px;
        background: rgba(255,255,255,.28);
        cursor: pointer;
        transition: width .35s ease, background .35s ease;
    }


        .aw-home-dot.active {
            width: 31px;
            background: #9b5cf6;
        }



    /* =====================================================
           COUNTER
           ===================================================== */

    .aw-home-counter {
        display: flex;
        align-items: center;
        gap: 9px;
        color: rgba(255,255,255,.40);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
        pointer-events: auto;
    }


        .aw-home-counter span:first-child {
            color: #ffffff;
            font-size: 11px;
        }


        .aw-home-counter i {
            width: 26px;
            height: 1px;
            display: block;
            background: rgba(255,255,255,.22);
        }



    /* =====================================================
           PROGRESS
           ===================================================== */

    .aw-home-progress {
        position: absolute;
        z-index: 25;
        left: 0;
        right: 0;
        bottom: 0;
        height: 2px;
        background: rgba(255,255,255,.025);
    }


    .aw-home-progress-value {
        width: 0%;
        height: 100%;
        background: linear-gradient( 90deg, #7c3aed, #d946ef );
        box-shadow: 0 0 15px rgba(139,92,246,.60);
    }



    /* =====================================================
           POPULAR SECTION
           ===================================================== */

    .aw-home-popular {
        max-width: 1500px;
        margin: 0 auto;
        padding: 45px clamp(25px, 6vw, 95px) 85px;
    }


    .aw-home-section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }


    .aw-home-section-label {
        display: block;
        margin-bottom: 5px;
        color: #8b5cf6;
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 2px;
    }


    .aw-home-section-head h2 {
        margin: 0;
        color: #ffffff;
        font-size: 27px;
        letter-spacing: -1px;
    }


    .aw-home-see-all {
        color: #9ca3af;
        font-size: 11px;
        text-decoration: none;
        transition: color .2s ease;
    }


        .aw-home-see-all:hover {
            color: #ffffff;
        }



    /* =====================================================
           POPULAR GRID
           ===================================================== */

    .aw-home-grid {
        display: grid;
        grid-template-columns: repeat( 6, minmax(0,1fr) );
        gap: 17px;
    }


    .aw-home-card {
        min-width: 0;
        color: inherit;
        text-decoration: none;
        transition: transform .25s ease;
    }


        .aw-home-card:hover {
            transform: translateY(-5px);
        }



    /* =====================================================
           CARD POSTER
           ===================================================== */

    .aw-home-card-poster {
        position: relative;
        width: 100%;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        border-radius: 11px;
        background: #10131a;
        box-shadow: 0 10px 30px rgba(0,0,0,.16);
    }


        .aw-home-card-poster img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .45s cubic-bezier(.2,.8,.2,1), filter .3s ease;
        }


    .aw-home-card:hover
    .aw-home-card-poster img {
        transform: scale(1.06);
        filter: brightness(.70);
    }


    .aw-home-card-empty {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #444b58;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 2px;
    }



    /* CARD RATING */

    .aw-home-card-rating {
        position: absolute;
        z-index: 5;
        top: 8px;
        right: 8px;
        padding: 5px 7px;
        border-radius: 6px;
        background: rgba(7,9,14,.82);
        backdrop-filter: blur(8px);
        color: #fbbf24;
        font-size: 9px;
        font-weight: 850;
    }



    /* CARD HOVER */

    .aw-home-card-hover {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        background: rgba(8,10,15,.15);
        transition: opacity .25s ease;
    }


    .aw-home-card:hover
    .aw-home-card-hover {
        opacity: 1;
    }


    .aw-home-card-play {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-left: 3px;
        border-radius: 50%;
        background: rgba(255,255,255,.95);
        color: #080a0f;
        font-size: 12px;
        transform: scale(.85);
        transition: transform .25s ease;
    }


    .aw-home-card:hover
    .aw-home-card-play {
        transform: scale(1);
    }



    /* =====================================================
           CARD INFO
           ===================================================== */

    .aw-home-card-info {
        padding: 10px 2px 0;
    }


        .aw-home-card-info h3 {
            margin: 0 0 6px;
            overflow: hidden;
            color: #f4f4f5;
            font-size: 12px;
            font-weight: 750;
            line-height: 1.35;
            white-space: nowrap;
            text-overflow: ellipsis;
        }


    .aw-home-card-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #606875;
        font-size: 9px;
    }


        .aw-home-card-meta i {
            width: 3px;
            height: 3px;
            display: block;
            border-radius: 50%;
            background: #454c57;
        }



    /* =====================================================
           EMPTY
           ===================================================== */

    .aw-home-no-hero,
    .aw-home-empty {
        text-align: center;
    }


    .aw-home-no-hero {
        min-height: 450px;
        padding: 150px 25px;
        box-sizing: border-box;
        background: radial-gradient( circle at center, rgba(139,92,246,.10), transparent 35% ), #080a0f;
    }


        .aw-home-no-hero span {
            color: #8b5cf6;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 3px;
        }


        .aw-home-no-hero h1 {
            margin: 12px 0;
            color: #ffffff;
            font-size: 50px;
        }


        .aw-home-no-hero p,
        .aw-home-empty p {
            color: #646c78;
        }



    /* =====================================================
           RESPONSIVE
           ===================================================== */

    @@media (max-width: 1250px) {

        .aw-home-grid {
            grid-template-columns: repeat(5, minmax(0,1fr));
        }
    }


    @@media (max-width: 1000px) {

        .aw-home-grid {
            grid-template-columns: repeat(4, minmax(0,1fr));
        }


        .aw-home-hero-inner {
            width: 70vw;
        }
    }


    @@media (max-width: 800px) {

        .aw-home-hero {
            height: 580px;
        }


        .aw-home-hero-content {
            padding: 95px 25px 90px;
        }


        .aw-home-hero-inner {
            width: 80vw;
        }


            .aw-home-hero-inner h1 {
                font-size: 50px;
            }


        .aw-home-arrow {
            display: none;
        }


        .aw-home-hero-navigation {
            left: 25px;
            right: 25px;
        }


        .aw-home-grid {
            grid-template-columns: repeat(3, minmax(0,1fr));
        }
    }


    @@media (max-width: 600px) {

        .aw-home-hero {
            height: 640px;
        }


        .aw-home-hero-overlay {
            background: linear-gradient( 0deg, #080a0f 0%, rgba(8,10,15,.94) 36%, rgba(8,10,15,.45) 100% );
        }


        .aw-home-hero-content {
            align-items: flex-end;
            padding: 95px 18px 95px;
        }


        .aw-home-hero-inner {
            width: 100%;
        }


