@model AnimeWave.ViewModels.EpisodeFormViewModel

<form method="post"
      class="admin-form">

    <input asp-for="Id"
           type="hidden" />

    <input asp-for="AnimeId"
           type="hidden" />


    <div class="form-group">

        <label asp-for="EpisodeNumber">
            Номер серии
        </label>

        <input asp-for="EpisodeNumber" />

    </div>


    <div class="form-group">

        <label asp-for="Title">
            Название
        </label>

        <input asp-for="Title" />

    </div>


    <div class="form-group">

        <label asp-for="Description">
            Описание
        </label>

        <textarea asp-for="Description"
                  rows="5"></textarea>

    </div>


    <div class="form-group">

        <label asp-for="DurationMinutes">
            Продолжительность
        </label>

        <input asp-for="DurationMinutes" />

    </div>


    <div class="form-group">

        <label asp-for="ThumbnailUrl">
            Картинка серии
        </label>

        <input asp-for="ThumbnailUrl"
               placeholder="/images/episodes/episode1.jpg" />

    </div>


    <button type="submit"
            class="auth-button">

        Сохранить

    </button>

</form>