@model AnimeWave.ViewModels.AnimeFormViewModel

<div class="aw-create-actions">
    <button type="submit" class="aw-create-submit">
        + Добавить аниме
    </button>

    <a asp-area="Admin"
       asp-controller="Anime"
       asp-action="Index"
       class="aw-create-cancel">
        Отмена
    </a>
</div>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    @await Html.PartialAsync("_AnimeForm", Model)

    <div class="aw-create-actions">

        <button type="submit"
                class="aw-create-submit">

            + Добавить аниме

        </button>


        <a asp-area="Admin"
           asp-controller="Anime"
           asp-action="Index"
           class="aw-create-cancel">

            Отмена

        </a>

    </div>

</form>