@model AnimeWave.ViewModels.AnimeFormViewModel

<div class="aw-create-actions">
    <button type="submit" class="aw-create-submit">
        💾 Сохранить изменения
    </button>

    <a asp-area="Admin"
       asp-controller="Anime"
       asp-action="Index"
       class="aw-create-cancel">
        Отмена
    </a>
</div>



<form asp-action="Edit" method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    @await Html.PartialAsync("_AnimeForm", Model)

    <div class="aw-create-actions">

        <button type="submit"
                class="aw-create-submit">

            💾 Сохранить изменения

        </button>


        <a asp-area="Admin"
           asp-controller="Anime"
           asp-action="Index"
           class="aw-create-cancel">

            Отмена

        </a>

    </div>

</form>