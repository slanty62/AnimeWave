@model AnimeWave.ViewModels.AnimeFormViewModel

<form method="post"
      class="admin-form">

    <input asp-for="Id"
           type="hidden" />


    <div asp-validation-summary="ModelOnly"
         class="validation"></div>


    <div class="form-grid">

        <div class="form-group">

            <label asp-for="Title">
                Название
            </label>

            <input asp-for="Title" />

        </div>


        <div class="form-group">

            <label asp-for="OriginalTitle">
                Оригинальное название
            </label>

            <input asp-for="OriginalTitle" />

        </div>


        <div class="form-group form-full">

            <label asp-for="Description">
                Описание
            </label>

            <textarea asp-for="Description"
                      rows="6"></textarea>

        </div>


        <div class="form-group">

            <label asp-for="ReleaseYear">
                Год
            </label>

            <input asp-for="ReleaseYear" />

        </div>


        <div class="form-group">

            <label asp-for="Rating">
                Рейтинг
            </label>

            <input asp-for="Rating"
                   step="0.1" />

        </div>


        <div class="form-group">

            <label asp-for="AgeRating">
                Возраст
            </label>

            <input asp-for="AgeRating"
                   placeholder="16+" />

        </div>


        <div class="form-group">

            <label asp-for="EpisodesCount">
                Количество серий
            </label>

            <input asp-for="EpisodesCount" />

        </div>


        <div class="form-group">

            <label asp-for="Status">
                Статус
            </label>

            <select asp-for="Status">

                <option>
                    Выходит
                </option>

                <option>
                    Завершён
                </option>

                <option>
                    Анонсирован
                </option>

            </select>

        </div>


        <div class="form-group form-full">

            <label asp-for="PosterUrl">
                Путь к постеру
            </label>

            <input asp-for="PosterUrl"
                   placeholder="/images/posters/example.jpg" />

        </div>


        <div class="form-group form-full">

            <label asp-for="BannerUrl">
                Путь к баннеру
            </label>

            <input asp-for="BannerUrl"
                   placeholder="/images/banners/example.jpg" />

        </div>


        <div class="form-group form-full">

            <label>
                Жанры
            </label>

            <div class="genre-checkboxes">

                @foreach (var genre in Model.Genres)
                {
                    bool selected =
                        Model.SelectedGenreIds.Contains(
                            int.Parse(genre.Value));

                    <label class="genre-checkbox">

                        <input type="checkbox"
                               name="SelectedGenreIds"
                               value="@genre.Value"
                               checked="@selected" />

                        @genre.Text

                    </label>
                }

            </div>

        </div>

    </div>


    <div class="admin-form-buttons">

        <button type="submit"
                class="auth-button">

            Сохранить

        </button>

        <a asp-action="Index"
           class="list-button">

            Отмена

        </a>

    </div>

</form>